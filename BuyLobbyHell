local RS = game:GetService("ReplicatedStorage")

local remoteCache = {}
local function getRemote(...)
    local key = table.concat({...}, "|")
    if remoteCache[key] then return remoteCache[key] end
    local obj = RS
    for _, child in ipairs({...}) do
        obj = obj:WaitForChild(child)
    end
    remoteCache[key] = obj
    return obj
end

local totalSuccess = 0
local totalFail    = 0

local function invoke(remote, args, label)
    local ok, err = pcall(function()
        remote:InvokeServer(table.unpack(args))
    end)
    if ok then
        totalSuccess += 1
        print(string.format("[✓] %s", label))
    else
        totalFail += 1
        warn(string.format("[✗] GAGAL: %s | %s", label, tostring(err)))
    end
    task.wait(CONFIG.DELAY)
end

local function fire(remote, args, label)
    local ok, err = pcall(function()
        remote:FireServer(table.unpack(args))
    end)
    if ok then
        totalSuccess += 1
        print(string.format("[✓] %s", label))
    else
        totalFail += 1
        warn(string.format("[✗] GAGAL: %s | %s", label, tostring(err)))
    end
    task.wait(CONFIG.DELAY)
end

-- Fungsi pintar: mendukung format { name = "Item", enabled = true } maupun string langsung "Item"
local function parseItem(entry)
    if type(entry) == "table" then
        return entry.name, (entry.enabled ~= false)
    else
        return tostring(entry), true
    end
end

local function printSection(title)
    print(string.format("\n%s\n[ %s ]\n%s", string.rep("-", 45), title, string.rep("-", 45)))
end

