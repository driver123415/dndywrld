                        print("Ichor belum cukup untuk beli Trinket " .. FallbackConfig.TrinketToBuy .. " (" .. currentIchor .. "/" .. FallbackConfig.TrinketCost .. ").")
                    end
                else
                    print("Trinket sudah terpasang di Slot.")
                end
            end
        end
    end
end

