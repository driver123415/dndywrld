end)

SpeedInput.FocusLost:Connect(function()
	local newSpeed = tonumber(SpeedInput.Text)
	if newSpeed and newSpeed >= 0 then
		currentSpeed = newSpeed -- Memperbarui kecepatan
	else
		SpeedInput.Text = tostring(currentSpeed) -- Kembalikan ke angka sebelumnya jika input tidak valid
	end
end)

-- ==========================================
-- LOGIKA UTAMA (AUTO FARM LOOP)
-- ==========================================
task.spawn(function()
	while scriptActive do
		task.wait(0.05) -- Jeda ringan agar UI tidak freeze
		
		if isRunning then
			pcall(function()
				local plotsFolder = workspace:FindFirstChild("Plots")
				if not plotsFolder then return end
				
				local myPlot = plotsFolder:FindFirstChild(player.Name)
				if not myPlot then return end
				
				local voxelsFolder = myPlot:FindFirstChild("VX_Model") and myPlot.VX_Model:FindFirstChild("Voxels")
				if not voxelsFolder then return end

				for _, voxel in ipairs(voxelsFolder:GetChildren()) do
					if not isRunning or not scriptActive then break end
					
					local isColored = getVoxelData(voxel, "Colored")
					
					if isColored == false or isColored == nil then
						local requiredColorIndex = getVoxelData(voxel, "kolor") 
						
						if requiredColorIndex then
							requiredColorIndex = tostring(requiredColorIndex)
							local paletaUI = player.PlayerGui.ScreenGui:FindFirstChild("Paleta")
							
							if paletaUI then
								local targetColorUI = paletaUI:FindFirstChild(requiredColorIndex)
								
								if targetColorUI and targetColorUI:IsA("GuiObject") then
									local activeColor3 = targetColorUI.BackgroundColor3
									
									activeColorEvent:FireServer(tonumber(requiredColorIndex), activeColor3)
									-- Menginjak lantai langsung setelah warna diaktifkan
									colorMeEvent:FireServer(voxel)
									
									-- Jeda Dinamis (Menggunakan kecepatan dari Config / GUI)
									task.wait(currentSpeed) 
								end
							end
						end
					end
				end
			end)
		end
	end
end)
