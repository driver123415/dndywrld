}

local function getFTUEFlagPath(tag)
    local userId   = tostring(LocalPlayer.UserId)
    local fileName = string.format("ftue_%s_%s.done", tag, userId)
    if isfolder and makefolder then
        pcall(function()
            if not isfolder(FTUE_FOLDER) then
                makefolder(FTUE_FOLDER)
            end
        end)
        local ok, exists = pcall(isfolder, FTUE_FOLDER)
        if ok and exists then
            return FTUE_FOLDER .. "/" .. fileName
        end
    end
    return fileName
end

local function getFTUEProgress(tag)
    if not canUseFiles then return 0 end
    local path = getFTUEFlagPath(tag)
    local okExists, exists = pcall(isfile, path)
    if not (okExists and exists) then return 0 end

    local okRead, content = pcall(readfile, path)
    if not okRead or type(content) ~= "string" then return 0 end

    local trimmed = string.gsub(content, "%s+", "")
    if trimmed == "done" then
        return math.huge
    end
    return tonumber(trimmed) or 0
end

local function saveFTUEProgress(tag, value)
    if not canUseFiles then return end
    pcall(writefile, getFTUEFlagPath(tag), tostring(value))
end

local function hasFTUEFlag(tag)
    local maxStep = FTUE_MAX_STEP[tag] or math.huge
    return getFTUEProgress(tag) >= maxStep
end

local function setFTUEFlag(tag)
    saveFTUEProgress(tag, "done")
end

