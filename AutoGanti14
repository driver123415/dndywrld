local FTUE_MAX_STEP = {
    new = 14,
    old = 43,
}

local OLD_FTUE_STEPS = {
    { step = 24, delay = 0.1 },
    { step = 25, delay = 0.1 },
    { step = 26, delay = 0.1 },
    { step = 27, delay = 0.1 },
    { step = 37, delay = 1.0 },
    { step = 38, delay = 1.0 },
    { step = 39, delay = 1.0 },
    { step = 40, delay = 1.0 },
    { step = 41, delay = 1.0 },
