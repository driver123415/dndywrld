local function getToonContainer()
    -- Prioritaskan CharacterFrame.ScrollingFrame karena langsung sinkron saat join
    -- (LoadoutFrame.MainPage.LeftScroll.Grid tidak memasang LockedOverlay sebelum dibuka)
    local oldFrame  = MainGui:FindFirstChild("CharacterFrame")
    local oldScroll = oldFrame and oldFrame:FindFirstChild("ScrollingFrame")
    if oldScroll and #oldScroll:GetChildren() > 0 then
        return oldScroll, "old"
    end

    local loadout    = MainGui:FindFirstChild("LoadoutFrame")
    local mainPage   = loadout and loadout:FindFirstChild("MainPage")
    local leftScroll = mainPage and mainPage:FindFirstChild("LeftScroll")
    local newGrid    = leftScroll and leftScroll:FindFirstChild("Grid")
    if newGrid and #newGrid:GetChildren() > 0 then
        return newGrid, "new"
    end

    return nil, nil
end

