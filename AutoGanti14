local function isTrinketItemLocked(item)
    local lockOverlay = item:FindFirstChild("LockedOverlay")
    local nameLbl     = item:FindFirstChild("CharacterName")
    return (lockOverlay and lockOverlay.Visible)
        or (nameLbl and nameLbl:IsA("TextLabel") and nameLbl.Text == "???")
end

local function isTrinketGridInitialized(grid)
    if not grid then return false end
    for _, item in ipairs(grid:GetChildren()) do
        if item:IsA("GuiButton") and item.Visible and not IGNORE_TEMPLATE_NAMES[item.Name] then
            if isTrinketItemLocked(item) then
                return true
            end
        end
    end
    return false
end

local function isTrinketOwned(grid, trinketName)
    local item = grid and grid:FindFirstChild(trinketName)
    if not item or not item.Visible then return false end
    return not isTrinketItemLocked(item)
end

local function getSlotImage(slotIndex)
    local slot      = MainGui:FindFirstChild("Slot" .. slotIndex)
    local itemImage = slot and slot:FindFirstChild("ItemImage")
    if itemImage and itemImage.Visible and itemImage.Image ~= "" then
        return itemImage.Image
    end
    return nil
end

local function isTargetEquipped(targets)
    local img1 = getSlotImage(1)
    local img2 = getSlotImage(2)
    if #targets == 2 then
        local a, b = targets[1].image, targets[2].image
        return (img1 == a and img2 == b) or (img1 == b and img2 == a)
    elseif #targets == 1 then
        local a = targets[1].image
        return (img1 == a) or (img2 == a)
    end
    return true
end

local function getBestOwnedTargets(grid)
    local targets = {}
    local picked  = {}
    for slotIndex = 1, #Config.TrinketSlots do
        for _, trinket in ipairs(Config.TrinketSlots[slotIndex]) do
            if not picked[trinket.name] and isTrinketOwned(grid, trinket.name) then
                table.insert(targets, trinket)
                picked[trinket.name] = true
                break
            end
        end
    end
    return targets
end

local function formatTargetNames(targets)
    local names = {}
    for _, t in ipairs(targets) do
        table.insert(names, t.name)
    end
    return table.concat(names, " + ")
end

local function SmartEquipTrinkets(justClaimedMonster)
    local primaryTargets = { Config.TrinketSlots[1][1], Config.TrinketSlots[2][1] }

    -- Cek paling cepat: kalau VeeRemote + StressBall sudah terpasang, langsung skip
    if isTargetEquipped(primaryTargets) then
        print("✅ Trinket utama (" .. formatTargetNames(primaryTargets) .. ") sudah terpasang. Skip equip.")
        return
    end

    local EquipTrinket = ReplicatedStorage:WaitForChild("EquipTrinket")
    local maxRetry     = Config.TrinketRetryBeforeFallback or 3
    local grid         = getTrinketGrid()

    -- Pastikan Grid trinket benar-benar sudah terinisialisasi (bukan lazy-init 0 locked)
    if grid and isTrinketGridInitialized(grid) then
        local targets        = getBestOwnedTargets(grid)
        local primary1       = Config.TrinketSlots[1][1]
        local primary2       = Config.TrinketSlots[2][1]
        local hasBothPrimary = isTrinketOwned(grid, primary1.name) and isTrinketOwned(grid, primary2.name)

        if not (justClaimedMonster and not hasBothPrimary) then
            if #targets == 0 then
                print("⚠️ Belum ada trinket prioritas yang terbuka di inventory. Skip equip.")
                return
            end

            if isTargetEquipped(targets) then
                print("✅ Trinket terbaik saat ini sudah terpasang (" .. formatTargetNames(targets) .. "). Skip equip.")
                return
            end

            print("🔄 Upgrade/ganti trinket ke: " .. formatTargetNames(targets))
            local attempts = 0
            repeat
                attempts += 1
                pcall(function() EquipTrinket:InvokeServer("None", "UnEquipAll") end)
                task.wait(1.2)

                for _, trinket in ipairs(targets) do
                    pcall(function() EquipTrinket:InvokeServer(trinket.name, "Equip") end)
                    task.wait(0.8)
                end

                if isTargetEquipped(targets) then
                    print("✅ Berhasil pasang: " .. formatTargetNames(targets))
                    return
                end

                warn(string.format("❌ [Percobaan %d] Verifikasi slot belum cocok. Retry...", attempts))
                task.wait(1)
            until attempts >= maxRetry

            warn("❌ Gagal pasang trinket setelah " .. maxRetry .. " percobaan.")
            return
        end

        print("🆕 Baru claim monster — cek cepat apakah trinket utama baru terbuka...")
        local function getCandidatesForSlot(slotIndex, excludeName)
            local list    = {}
            local primary = Config.TrinketSlots[slotIndex][1]
            if primary and primary.name ~= excludeName and not isTrinketOwned(grid, primary.name) then
                table.insert(list, primary)
            end
            for _, trinket in ipairs(Config.TrinketSlots[slotIndex]) do
                if trinket.name ~= excludeName and isTrinketOwned(grid, trinket.name) then
                    table.insert(list, trinket)
                    break
                end
            end
            return list
        end

        local attempts = 0
        repeat
            attempts += 1
            pcall(function() EquipTrinket:InvokeServer("None", "UnEquipAll") end)
            task.wait(1.2)

            local equipped = {}
            local picked   = {}

            for slotIndex = 1, #Config.TrinketSlots do
                local nextSlot   = #equipped + 1
                local exclude    = equipped[1] and equipped[1].name or nil
                local candidates = getCandidatesForSlot(slotIndex, exclude)
                for _, trinket in ipairs(candidates) do
                    if not picked[trinket.name] then
                        pcall(function() EquipTrinket:InvokeServer(trinket.name, "Equip") end)
                        task.wait(0.8)
                        if getSlotImage(nextSlot) == trinket.image then
                            table.insert(equipped, trinket)
                            picked[trinket.name] = true
                            break
                        end
                    end
                end
            end

            if #equipped > 0 then
                print("✅ Trinket pasca-claim terpasang: " .. formatTargetNames(equipped))
                return
            end

            task.wait(1)
        until attempts >= maxRetry
        return
    end

    -- Fallback aman jika Grid trinket belum terinisialisasi (lazy-init) atau path berubah
    print("🔧 Grid trinket belum terinisialisasi — menjalankan equip prioritas...")
    local attempts = 0
    repeat
        attempts += 1
        pcall(function() EquipTrinket:InvokeServer("None", "UnEquipAll") end)
        task.wait(1.5)

        local equipped = {}
        local picked   = {}
        for slotIndex = 1, #Config.TrinketSlots do
            local nextSlot = #equipped + 1
            for _, trinket in ipairs(Config.TrinketSlots[slotIndex]) do
                if not picked[trinket.name] then
                    pcall(function() EquipTrinket:InvokeServer(trinket.name, "Equip") end)
                    task.wait(0.8)
                    if getSlotImage(nextSlot) == trinket.image then
                        table.insert(equipped, trinket)
                        picked[trinket.name] = true
                        break
                    end
                end
            end
        end

        if #equipped > 0 then
            print("✅ Trinket terpasang: " .. formatTargetNames(equipped))
            return
        end
        task.wait(1)
    until attempts >= maxRetry
