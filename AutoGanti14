local function runNewPlayerFTUE()
    local lastStep = getFTUEProgress("new")
    if lastStep >= FTUE_MAX_STEP.new then
        print("⏭️ FTUE New Player sudah selesai untuk UserId " .. LocalPlayer.UserId .. ". Skip.")
        return true
    end

    local remoteEvent = getFTUERemoteEvent()
    if not remoteEvent then
        warn("⚠️ RemoteEvent FTUE tidak ditemukan (New Player).")
        return false
    end

    if lastStep > 0 then
        print(string.format("▶️ Melanjutkan FTUE New Player setelah step %d...", lastStep))
    end

    for step = 9, 14 do
        if step > lastStep then
            task.wait(0.1)
            remoteEvent:FireServer("AdvanceFTUEStep", step)
            task.wait(0.1)
            saveFTUEProgress("new", step)
        end
    end

    setFTUEFlag("new")
    print("✅ FTUE New Player (Step 9-14) selesai & tersimpan di " .. getFTUEFlagPath("new"))
    return true
end

local function runOldPlayerFTUE()
    local lastStep = getFTUEProgress("old")
    if lastStep >= FTUE_MAX_STEP.old then
        print("⏭️ FTUE Old Player (24-27 & 37-43) sudah selesai untuk UserId " .. LocalPlayer.UserId .. ". Skip.")
        return
    end

    local remoteEvent = getFTUERemoteEvent()
    if not remoteEvent then
        warn("⚠️ RemoteEvent FTUE tidak ditemukan (Old Player).")
        return
    end

    if lastStep > 0 then
        print(string.format("▶️ Melanjutkan FTUE Old Player setelah step %d...", lastStep))
    end

    for _, entry in ipairs(OLD_FTUE_STEPS) do
        if entry.step > lastStep then
            task.wait(entry.delay)
            remoteEvent:FireServer("AdvanceFTUEStep", entry.step)
            task.wait(0.15)
            saveFTUEProgress("old", entry.step)
            print(string.format("✅ FTUE Step %d selesai & tersimpan.", entry.step))
        end
    end

    setFTUEFlag("old")
    print("✅ Semua FTUE Old Player (24-27 & 37-43) tuntas & tersimpan di " .. getFTUEFlagPath("old"))
end

