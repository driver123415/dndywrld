local function isToonOwned(toonName)
    if IGNORE_TEMPLATE_NAMES[toonName] then return false end
    local container, mode = getToonContainer()
    local toonUI = container and container:FindFirstChild(toonName)
    if not toonUI then return false end

    if mode == "old" then
        return toonUI.Visible == true
    else
        local lock = toonUI:FindFirstChild("LockedOverlay") or toonUI:FindFirstChild("Locked")
        return not (lock and lock.Visible)
    end
end

local function hasMasteryStar(toonName)
    if IGNORE_TEMPLATE_NAMES[toonName] then return false end
    local container = getToonContainer()
    local toonUI = container and container:FindFirstChild(toonName)
    if not toonUI then return false end
    local mStar = toonUI:FindFirstChild("MasteryStar")
    return mStar ~= nil and mStar.Visible == true
end

local function countTotalMasteryStars()
    local container, mode = getToonContainer()
    if not container then return 0 end

    local total = 0
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("GuiObject") and not IGNORE_TEMPLATE_NAMES[child.Name] then
            local owned
            if mode == "old" then
                owned = child.Visible == true
            else
                local lock = child:FindFirstChild("LockedOverlay") or child:FindFirstChild("Locked")
                owned = not (lock and lock.Visible)
            end

            if owned then
                local mStar = child:FindFirstChild("MasteryStar")
                if mStar and mStar.Visible then
                    total += 1
                end
            end
        end
    end
    return total
end

