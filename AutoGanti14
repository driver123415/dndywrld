local function getClaimableJournalIDs()
    local dj     = MainGui:FindFirstChild("DreamJournal")
    local margin = dj and dj:FindFirstChild("Margin")
    local pages  = margin and margin:FindFirstChild("Pages")
    local medals = pages and pages:FindFirstChild("Medals")
    local mMarg  = medals and medals:FindFirstChild("Margin")
    local scroll = mMarg and mMarg:FindFirstChild("ScrollingFrame")
    if not scroll then return nil end

    local function countLoadedMedals()
        local n = 0
        for _, child in ipairs(scroll:GetChildren()) do
            if child:GetAttribute("AchievementID") ~= nil then
                n += 1
            end
        end
        return n
    end

    local openedByScript = false
    if countLoadedMedals() == 0 then
        local jBtn = getJournalButton()
        if jBtn then
            openedByScript = true
            fireButton(jBtn)
            local t = 0
            while t < 0.6 and countLoadedMedals() == 0 do
                task.wait(0.1)
                t += 0.1
            end
            if countLoadedMedals() == 0 and dj and not dj.Visible then
                virtualClickButton(jBtn)
                t = 0
                while t < 0.8 and countLoadedMedals() == 0 do
                    task.wait(0.1)
                    t += 0.1
                end
            end
        end
    end

    local claimable = {}
    local seen      = {}
    local totalRead = 0

    for _, child in ipairs(scroll:GetChildren()) do
        local achId = child:GetAttribute("AchievementID")
        if type(achId) == "string" and achId ~= "" then
            totalRead += 1
            if not seen[achId] then
                local canRedeem = child:GetAttribute("CanRedeem")
                local redeemed  = child:GetAttribute("Redeemed")
                local state     = child:GetAttribute("state")
                if redeemed ~= true and (canRedeem == true or state == "CanRedeem") then
                    seen[achId] = true
                    table.insert(claimable, achId)
                end
            end
        end
    end

    if openedByScript then
        closeDreamJournal()
    end

    return claimable, totalRead
end

local function getCurrentlyUsedToon()
    local myCharInfo = nil
    local wsPlayers  = Workspace:FindFirstChild("Players")
    if wsPlayers then myCharInfo = wsPlayers:FindFirstChild(LocalPlayer.Name) end
    if not myCharInfo then myCharInfo = LocalPlayer.Character end
    if not myCharInfo then myCharInfo = Workspace:FindFirstChild(LocalPlayer.Name) end
