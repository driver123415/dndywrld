    for i, m in ipairs(tpModesOrder) do
        if string.lower(m) == string.lower(cur) then
            nextIdx = (i % #tpModesOrder) + 1
            break
        end
    end
    Config.Teleport.Mode = tpModesOrder[nextIdx]
    tpModeBtn.Text = "TP: " .. string.upper(Config.Teleport.Mode)
    cprint("[CONFIG] Teleport Mode diubah ke: " .. Config.Teleport.Mode)
    refreshDashboardGUI(true)
end)

