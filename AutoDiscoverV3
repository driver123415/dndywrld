local function getResearchFolder()
    local PlayerData = ReplicatedStorage:FindFirstChild("PlayerData")
    local UserFolder = PlayerData and PlayerData:FindFirstChild(userId)
    return UserFolder and UserFolder:FindFirstChild("Research") or nil
end

local function parseResearchValue(researchObj)
    if not researchObj or not researchObj:IsA("ValueBase") then return 0 end
    local rawVal = tostring(researchObj.Value)
    local clean  = string.gsub(rawVal, "%%", "")
    local num    = tonumber(clean)
    if num then
        return math.clamp(math.floor(num + 0.5), 0, 100)
    end
    return 0
end

local function getMonsterResearchPercent(monsterName)
    local ResearchFolder = getResearchFolder()
    if ResearchFolder then
        local researchObj = ResearchFolder:FindFirstChild(monsterName)
        if researchObj then
            return parseResearchValue(researchObj)
        end
    end
    return 0
end

local function getActiveMonstersInCurrentFloor()
    local activeMap = {}
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, m in ipairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") then
                activeMap[m.Name] = m
            end
        end
    end
    return activeMap
end

-- Hybrid: Auto-sync dari PlayerData.Research + lantai aktif, digabung daftar dasar agar monster 0% tetap tampil
local function getAllTwistedResearchReport()
    local ResearchFolder = getResearchFolder()
    local activeInMap    = getActiveMonstersInCurrentFloor()
    local maxThresh      = Config.Discover.TargetMaxPercent or 0

    local report     = {}
    local targetSet  = {}
    local targetNeed = {}
    local zeroCount  = 0
    local under100   = 0
    local seenNames  = {}

    local function addEntry(mName, pct)
        if seenNames[mName] then return end
        local isEvent  = (EventMonsterSet[mName] == true)
        local isLethal = (LethalMonsterSet[mName] == true)
        if isEvent and not Config.Discover.IncludeEventMonsters then
            return
        end

        seenNames[mName] = true
        local inFloor  = (activeInMap[mName] ~= nil)
        local category = isLethal and "Lethal" or (isEvent and "Event" or "Standard")

        if pct == 0 then zeroCount = zeroCount + 1 end
        if pct < 100 then under100 = under100 + 1 end

        local needsDiscover = (pct <= maxThresh)
        if needsDiscover then
            table.insert(targetNeed, mName)
            targetSet[mName] = true
        end

        table.insert(report, {
            name          = mName,
            cleanName     = string.gsub(mName, "Monster$", ""),
            category      = category,
            isLethal      = isLethal,
            percent       = pct,
            inFloor       = inFloor,
            needsDiscover = needsDiscover
        })
    end

    -- 1. Baca semua yang sudah tercatat di folder Research (termasuk monster update baru)
    if ResearchFolder then
        for _, researchObj in ipairs(ResearchFolder:GetChildren()) do
            if researchObj:IsA("ValueBase") then
                addEntry(researchObj.Name, parseResearchValue(researchObj))
            end
        end
    end

    -- 2. Lengkapi monster 0% dari daftar dasar Config (belum dibuatkan entry oleh server)
    for _, mName in ipairs(Config.StandardMonsters or {}) do
        addEntry(mName, 0)
    end
    for _, mName in ipairs(Config.LethalMonsters or {}) do
        addEntry(mName, 0)
    end
    if Config.Discover.IncludeEventMonsters then
        for _, mName in ipairs(Config.EventMonsters or {}) do
            addEntry(mName, 0)
        end
    end

    -- 3. Antisipasi monster update baru yang belum ada di Research & Config tapi sedang spawn di lantai
    for mName, _ in pairs(activeInMap) do
        addEntry(mName, 0)
    end

    table.sort(report, function(a, b)
        if a.inFloor ~= b.inFloor then return a.inFloor end
        if a.percent ~= b.percent then return a.percent < b.percent end
        return a.cleanName < b.cleanName
    end)

    return report, targetNeed, targetSet, zeroCount, under100, #report
end

-- Lacak encounter manual sebelum/selama trigger aktif (+5%/+10% = encounter; +1%/+2% = kapsul)
local function syncManualEncounters()
    local ResearchFolder = getResearchFolder()
    if not ResearchFolder then return end

    local minDelta = Config.Discover.EncounterMinDelta or 5

    if not hasInitResearchSnap then
        for _, obj in ipairs(ResearchFolder:GetChildren()) do
            if obj:IsA("ValueBase") then
                lastKnownResearch[obj.Name] = parseResearchValue(obj)
            end
        end
        hasInitResearchSnap = true
        return
    end

    for _, obj in ipairs(ResearchFolder:GetChildren()) do
        if obj:IsA("ValueBase") then
            local mName  = obj.Name
            local curPct = parseResearchValue(obj)
            local prev   = lastKnownResearch[mName] or 0
            local delta  = curPct - prev

            if curPct > prev then
                lastKnownResearch[mName] = curPct
                if (delta >= minDelta or curPct >= 100) and not discoveredThisFloor[mName] then
                    discoveredThisFloor[mName] = true
                    cprint(string.format(
                        "[AUTO-TRACK] ✔ %s naik +%d%% (%d%% -> %d%%) secara manual! Skip TP di lantai ini.",
                        mName, delta, prev, curPct
                    ))
                end
            end
        end
    end
end

-- Pilih posisi menatap di sisi target yang paling jauh dari monster lain
local function getSafestApproachOffset(targetModel, monsterPos, dist, heightOff)
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    local otherPositions = {}

    if monstersFolder then
        for _, m in ipairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") and m ~= targetModel then
                local p = getMonsterPart(m)
                if p then
                    table.insert(otherPositions, p.Position)
                end
            end
        end
    end

    if #otherPositions == 0 then
        return Vector3.new(dist, heightOff, 0)
    end

    local bestOffset = Vector3.new(dist, heightOff, 0)
    local bestClearance = -1

    for i = 0, 7 do
        local angle  = (i / 8) * (math.pi * 2)
        local offset = Vector3.new(math.cos(angle) * dist, heightOff, math.sin(angle) * dist)
        local testPt = monsterPos + offset

        local nearestOther = math.huge
        for _, otherPos in ipairs(otherPositions) do
            local d = (otherPos - testPt).Magnitude
            if d < nearestOther then
                nearestOther = d
            end
        end

        if nearestOther > bestClearance then
            bestClearance = nearestOther
            bestOffset    = offset
        end
    end

    return bestOffset
end

local function isSpottedEyeActive()
    local pGui = player:FindFirstChild("PlayerGui")
    local hud  = pGui and pGui:FindFirstChild("HUD")
    local se   = hud and hud:FindFirstChild("SpottedEye")
    local eye  = se and se:FindFirstChild("Eye")

    -- Aman = ImgTrans 1.00 | Ketahuan = ImgTrans 0.00 | Fade-out = 0.75 -> 1.00
    if se and se.Visible and eye and eye:IsA("ImageLabel") and eye.Visible then
        return eye.ImageTransparency < 0.5
    end
    return false
end

local function executeHitAndRun(monsterModel, loopId)
    local mPart = getMonsterPart(monsterModel)
    if not mPart then return false end

    character = player.Character
    rootPart  = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    local deadlineReached, secLeft = isPanicDeadlineReached()
    if deadlineReached then
        cprint(string.format("[SAFETY ABORT] Sisa waktu lift %s detik! Batal Hit & Run, langsung 1x TP ke Real Elevator!", tostring(secLeft)))
        ensureLockedInsideRealElevator1000Percent(false)
        return false
    end

    local monsterName          = monsterModel.Name
    local initPct              = getMonsterResearchPercent(monsterName)
    local confirmedByResearch  = false
    local retreatedBySpotted   = false

    -- Bungkus pcall agar karakter TIDAK PERNAH nyangkut Anchored / Gravity = 0 jika ada error
    local ok, err = pcall(function()
        clearAllServerSyncedHolds()
        setTargetColliderPassable(nil, false)

        local spottedBefore = isSpottedEyeActive()
        local hum           = character and character:FindFirstChildOfClass("Humanoid")
        local initHealth    = hum and hum.Health or nil

        local dist         = Config.Discover.DistanceToMonster or 15
        local heightOff    = Config.Discover.HeightOffset or 3
        local monsterPos   = mPart.Position
        local safeOffset   = getSafestApproachOffset(monsterModel, monsterPos, dist, heightOff)
        local myTargetPos  = monsterPos + safeOffset
        local lookAtCFrame = CFrame.lookAt(myTargetPos, monsterPos)

        currentStatusText = "HIT & RUN -> " .. monsterName
        cprint("[AUTO-DISCOVER] 🎯 Mengunci Target: " .. monsterName .. " (" .. initPct .. "%) via Mode: " .. tostring(Config.Teleport.Mode))

        moveCharacterTo(lookAtCFrame, true, false)
        if rootPart then rootPart.Anchored = true end

        local maxTicks = math.floor((Config.Discover.MaxWaitSeconds or 3.5) / 0.1)

        for _ = 1, maxTicks do
            if isScriptDestroyed or not isAutoDiscovering or activeLoopId ~= loopId then
                return
            end

            local isUrgent, remSec = isPanicDeadlineReached()
            if isUrgent then
                cprint(string.format("[PANIC SAFETY] Sisa waktu lift %s detik! Memutus penguncian & langsung masuk Real Elevator!", tostring(remSec)))
                break
            end

            -- Failsafe darurat: langsung kabur jika nyawa berkurang saat menatap monster
            if hum and initHealth and hum.Health < initHealth then
                cprint("[AUTO-DISCOVER] ⚠ HP berkurang saat Hit & Run (" .. monsterName .. ")! Langsung mundur ke SafePlace!")
                break
            end

            if not monsterModel.Parent then
                break
            end

            local curMPart = getMonsterPart(monsterModel)
            if curMPart and rootPart then
                local mPos = curMPart.Position
                local tPos = mPos + safeOffset
                rootPart.CFrame = CFrame.lookAt(tPos, mPos)
            end

            -- 1. Bukti paling valid: angka Research target naik langsung dari server
            local curPct = getMonsterResearchPercent(monsterName)
            if curPct > initPct then
                cprint(string.format("[AUTO-DISCOVER] ✔ Terkonfirmasi Discover %s (%d%% -> %d%%) via Research!", monsterName, initPct, curPct))
                confirmedByResearch = true
                break
            end

            -- Jika sebelumnya ter-spot monster lain lalu sempat padam, aktifkan kembali sensor SpottedEye
            if spottedBefore and not isSpottedEyeActive() then
                spottedBefore = false
            end

            -- 2. Sensor instan SpottedEye: langsung kabur demi aman, lalu verifikasi Research setelah di SafePlace
            if (not spottedBefore) and isSpottedEyeActive() then
                cprint("[AUTO-DISCOVER] 👁️ SpottedEye menyala! Mundur aman dulu, lalu verifikasi Research...")
                retreatedBySpotted = true
                break
            end

            task.wait(0.1)
        end
    end)

    -- Cleanup wajib (pasti dijalankan walaupun error atau dibatalkan)
    if rootPart then rootPart.Anchored = false end
    restoreNormalGravity()

    if not ok then
        warn("[AUTO-DISCOVER] Error saat Hit & Run (" .. tostring(monsterName) .. "): " .. tostring(err))
    end

    if isScriptDestroyed or not isAutoDiscovering or activeLoopId ~= loopId then
        clearAllServerSyncedHolds()
        setTargetColliderPassable(nil, false)
        return confirmedByResearch
    end

    -- Mundur ke SafePlace dulu (juga memberi waktu server sinkronisasi data Research)
    local panicNow = isPanicTimeActive()
    if panicNow and Config.ElevatorSafety.AlwaysLockInElevatorOnPanic then
        cprint("[AUTO-DISCOVER] 💨 Selesai Hit & Run saat Panic Time! 1x Teleport kembali ke Real Elevator...")
        ensureLockedInsideRealElevator1000Percent(true)
    else
        cprint("[AUTO-DISCOVER] 💨 Ngungsi ke tengah Thick Collider SafePlace lalu lepas...")
        moveToSafePlace()
    end

    -- Verifikasi Pasca-Mundur: cek apakah Research target benar-benar naik (anti false positive SpottedEye)
    local afterPct = getMonsterResearchPercent(monsterName)
    if (not confirmedByResearch) and retreatedBySpotted and afterPct <= initPct then
        task.wait(0.45)
        afterPct = getMonsterResearchPercent(monsterName)
    end

    if afterPct > initPct then
        if not confirmedByResearch then
            cprint(string.format("[AUTO-DISCOVER] ✔ Verifikasi sukses! Research %s naik (%d%% -> %d%%).", monsterName, initPct, afterPct))
        end
        confirmedByResearch = true
    elseif retreatedBySpotted then
        cprint(string.format("[AUTO-DISCOVER] ⚠ SpottedEye palsu (kemungkinan dari monster lain)! Research %s tetap %d%%.", monsterName, afterPct))
    end

    lastKnownResearch[monsterName] = math.max(lastKnownResearch[monsterName] or 0, afterPct)

    if confirmedByResearch then
        discoveredThisFloor[monsterName] = true
    else
        attemptsThisFloor[monsterName] = (attemptsThisFloor[monsterName] or 0) + 1
        local maxAtt = Config.Discover.MaxAttemptsPerFloor or 2
        if attemptsThisFloor[monsterName] >= maxAtt then
            discoveredThisFloor[monsterName] = true
            cprint(string.format("[AUTO-DISCOVER] ⚠ Gagal discover %s setelah %dx coba di lantai ini. Dilewati.", monsterName, maxAtt))
        else
            cprint(string.format("[AUTO-DISCOVER] ↻ Belum ter-discover (%s), percobaan %d/%d. Menunggu momen aman...", monsterName, attemptsThisFloor[monsterName], maxAtt))
        end
    end

    task.wait(0.4)
    return confirmedByResearch
end

