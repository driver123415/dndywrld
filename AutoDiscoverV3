local userId = tostring(player.UserId)

local function waitUntilReadyInMatch()
    -- 1. Tunggu Character & HumanoidRootPart
    local char = player.Character or player.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart", 15)

    -- 2. Tunggu ReplicatedStorage.PlayerData[userId].Research tersedia
    local pd = ReplicatedStorage:WaitForChild("PlayerData", 30)
    if pd then
        local uf = pd:WaitForChild(userId, 30)
        if uf then
            uf:WaitForChild("Research", 30)
        end
    end

    -- 3. Tunggu match siap (Elevator / CurrentRoom / HUD FloorStatus sudah ter-load)
    local startWait = os.clock()
    while (os.clock() - startWait) < 60 do
        local pGui        = player:FindFirstChild("PlayerGui")
        local hud         = pGui and pGui:FindFirstChild("HUD")
        local topbar      = hud and hud:FindFirstChild("Topbar")
        local floorStatus = topbar and topbar:FindFirstChild("FloorStatus")

        local elevators   = Workspace:FindFirstChild("Elevators")
        local hasElevator = elevators and (elevators:FindFirstChild("Elevator") ~= nil)
        local curRoom     = Workspace:FindFirstChild("CurrentRoom")
        local hasMap      = curRoom and (curRoom:FindFirstChildWhichIsA("Model") ~= nil)
        local inGame      = Workspace:FindFirstChild("InGamePlayers")
        local playerReady = (not inGame) or (inGame:FindFirstChild(player.Name) ~= nil)

        if playerReady and (floorStatus or hasElevator or hasMap) then
            break
        end
        task.wait(0.5)
    end

    -- Jeda singkat untuk stabilisasi posisi awal di dalam elevator
    task.wait(1.5)
end

waitUntilReadyInMatch()

