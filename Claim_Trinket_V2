-- ==================== HELPER ====================
local function getMonsterButton()
    local pGui = player:FindFirstChild("PlayerGui")
    local mainGui = pGui and pGui:FindFirstChild("MainGui")
    return mainGui
        and mainGui:FindFirstChild("Menu")
        and mainGui.Menu:FindFirstChild("LeftSide")
        and mainGui.Menu.LeftSide:FindFirstChild("MonsterButton")
end

local function getUnclaimedCount()
    local btn = getMonsterButton()
    local indicator = btn and btn:FindFirstChild("NewIndicator")
    
    if not indicator or not indicator.Visible then
        return 0
    end
    
    local label = indicator:FindFirstChild("TextLabel")
    if label then
        return tonumber(label.Text) or 0
    end
    return 0
end

local function clickMonsterButton()
    local btn = getMonsterButton()
    if btn and btn:IsA("TextButton") then
        local inset = GuiService:GetGuiInset()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local centerX = pos.X + size.X / 2
        local centerY = pos.Y + size.Y / 2 + inset.Y

        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
        task.wait(0.1)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
        print("🖱️ MonsterButton diklik — trigger update GUI")
    else
        warn("⚠️ MonsterButton tidak ditemukan!")
    end
end

-- ==================== MAIN CLAIM ====================
local function runClaim()
    print("==================================================")
    print("🎯 TWISTED CLAIM SCRIPT — FAST MODE")
    print("==================================================")

    local failed = {}

    print("🔁 PASS 1 - Claiming all monsters...")
    for index, monsterName in ipairs(monsterList) do
        local success, err = pcall(function()
            EarnMonsterTrinket:InvokeServer(monsterName)
        end)
        if success then
            print(string.format("[%d/%d] ✅ %s", index, #monsterList, monsterName))
        else
            warn(string.format("[%d/%d] ❌ %s | %s", index, #monsterList, monsterName, tostring(err)))
            table.insert(failed, monsterName)
        end
        task.wait(WAIT_BETWEEN)
    end

    local attempt = 1
    while #failed > 0 and attempt <= MAX_RETRY do
        print(string.format("🔁 RETRY #%d — %d monsters...", attempt, #failed))
        task.wait(WAIT_RETRY)
        local stillFailed = {}
        for _, monsterName in ipairs(failed) do
            local success, err = pcall(function()
                EarnMonsterTrinket:InvokeServer(monsterName)
            end)
            if success then
                print("✅ RETRY OK: " .. monsterName)
            else
                warn("❌ RETRY fail: " .. monsterName .. " | " .. tostring(err))
                table.insert(stillFailed, monsterName)
            end
            task.wait(WAIT_BETWEEN)
        end
        failed = stillFailed
        attempt = attempt + 1
    end

    task.wait(0.5)
    clickMonsterButton()
    task.wait(1.5)

    local afterCount = getUnclaimedCount()
    print("==================================================")
    print(string.format("📊 NewIndicator sesudah claim: %d", afterCount))

    if afterCount == 0 then
        print("🎉 Semua trinket berhasil di-claim!")
    else
        print(string.format("⚠️ Masih ada %d yang belum ke-claim", afterCount))
    end

    if #failed > 0 then
        print("❌ Permanently failed:")
        for _, m in ipairs(failed) do print("   └─ " .. m) end
    end
    print("==================================================")
end

runClaim()
