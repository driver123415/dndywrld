-- CORE LOGIC 1: AUTO FARM VOXEL (BACKGROUND LOOP)
-- ==========================================
-- Loop ini akan terus siaga dan mewarnai jika ada Voxel yang belum diwarnai
task.spawn(function()
	while scriptActive do
		task.wait(0.05)
		if isRunning then
			pcall(function()
				local myPlot = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild(player.Name)
				local voxelsFolder = myPlot and myPlot:FindFirstChild("VX_Model") and myPlot.VX_Model:FindFirstChild("Voxels")
				
				if voxelsFolder then
					for _, voxel in ipairs(voxelsFolder:GetChildren()) do
						if not isRunning or not scriptActive then break end
						
						local isColored = getVoxelData(voxel, "Colored")
						if isColored == false or isColored == nil then
							local requiredColorIndex = getVoxelData(voxel, "kolor") 
							if requiredColorIndex then
								local paletaUI = player.PlayerGui.ScreenGui:FindFirstChild("Paleta")
								local targetColorUI = paletaUI and paletaUI:FindFirstChild(tostring(requiredColorIndex))
								
								if targetColorUI and targetColorUI:IsA("GuiObject") then
									activeColorEvent:FireServer(tonumber(requiredColorIndex), targetColorUI.BackgroundColor3)
									colorMeEvent:FireServer(voxel)
									task.wait(currentSpeed) 
								end
							end
						end
					end
				end
			end)
		end
	end
end)

