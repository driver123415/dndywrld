-- ==========================================
-- HELPER FUNCTIONS
-- ==========================================
local function getVoxelData(voxel, dataName)
	local attr = voxel:GetAttribute(dataName)
	if attr ~= nil then return attr end
	local child = voxel:FindFirstChild(dataName)
	if child and child:IsA("ValueBase") then return child.Value end
	return nil
end

-- Fungsi untuk memicu klik pada tombol GUI secara virtual
local function fireVirtualClick(button)
	if not button then return end
	if firesignal then
		firesignal(button.MouseButton1Click)
	elseif getconnections then
		for _, conn in pairs(getconnections(button.MouseButton1Click)) do
			conn:Fire()
		end
	end
end

-- Mengambil angka dari text (contoh: "⭐ 140" menjadi 140)
local function parseNumber(text)
	local str = tostring(text):gsub("%D", "") -- Hapus semua karakter kecuali angka
	return tonumber(str) or 0
end

