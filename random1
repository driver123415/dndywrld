-- CORE LOGIC 2: MACRO AUTO BUY & PLAY
-- ==========================================
-- Fungsi untuk menunggu sampai semua lantai selesai diwarnai
local function waitForPaintingFinished(voxelsFolder)
	while scriptActive and isRunning do
		task.wait(1)
		local allDone = true
		local children = voxelsFolder:GetChildren()
		
		if #children == 0 then allDone = false end
		for _, voxel in ipairs(children) do
			local colored = getVoxelData(voxel, "Colored")
			if colored == false or colored == nil then
				allDone = false
				break
			end
		end
		
		if allDone and #children > 0 then return true end
	end
	return false
end

-- Fungsi mencari Art yang bisa dibeli
local function findNextArt()
	local shopGui = player.PlayerGui:FindFirstChild("ShopGui")
	if not shopGui then return nil end
	
	local container = shopGui:FindFirstChild("Container")
	local itemsFrame = container and container:FindFirstChild("ItemsFrame")
	local starsLabel = container and container:FindFirstChild("Stars")
	
	if not itemsFrame or not starsLabel then return nil end
	
	local currentMoney = parseNumber(starsLabel.Text)
	
	for _, item in ipairs(itemsFrame:GetChildren()) do
		if item:IsA("Frame") or item:IsA("GuiObject") then
			local statusLabel = item:FindFirstChild("Status")
			local titleLabel = item:FindFirstChild("Title")
			
			if statusLabel then
				local statusText = statusLabel.Text
				
				-- Cek Rule 2: Skip yang sudah DONE
				if statusText ~= "⚝👍⚝" then
					
					-- Cek Rule 1: VIP Logic
					local isVIP = titleLabel and string.find(titleLabel.Text, "VIP")
					if (not isVIP) or (isVIP and buyVIP) then
						
						-- Cek Harga
						local price = parseNumber(statusText)
						if price > 0 and currentMoney >= price then
							return item.Name -- Kembalikan nama Art
						end
					end
				end
			end
		end
	end
	return nil
end

-- Loop Utama Macro
task.spawn(function()
	while scriptActive do
		task.wait(1)
		
		if isRunning then
			setStatus("Mencari Art di Shop...")
			local nextArtName = findNextArt()
			
			if nextArtName then
				setStatus("Membeli: " .. nextArtName)
				
				-- Remote 1 & 2
				toCacheEvent:FireServer()
				task.wait(0.5)
				generateModelFunc:InvokeServer(nextArtName, "NEW")
				task.wait(0.5)
				
				-- Remote 3
				setStatus("Memulai Art...")
				interactItemFunc:InvokeServer(nextArtName)
				task.wait(1.5)
				
				-- Klik tombol GO jika ada
				local screenGui = player.PlayerGui:FindFirstChild("ScreenGui")
				local startUI = screenGui and screenGui:FindFirstChild("Start")
				if startUI and startUI:FindFirstChild("Go") then
					fireVirtualClick(startUI.Go)
					task.wait(1)
				end
				
				setStatus("Mewarnai " .. nextArtName .. "...")
				-- Background Loop (Core 1) sedang bekerja, kita tunggu di sini
				local myPlot = workspace:WaitForChild("Plots"):WaitForChild(player.Name)
				local voxelsFolder = myPlot:WaitForChild("VX_Model"):WaitForChild("Voxels")
				
				local finished = waitForPaintingFinished(voxelsFolder)
				
				if finished and isRunning then
					setStatus("Menyelesaikan Art & Klaim...")
					
					-- Remote 4 s/d 8
					isPaintingEvent:FireServer(myPlot.VX_Model, false, "DONE")
					task.wait(0.5)
					updateStarsFunc:InvokeServer(nextArtName)
					task.wait(0.2)
					boomColorsEvent:FireServer()
					task.wait(0.2)
					danceEvent:FireServer(7)
					task.wait(0.2)
					dymekEvent:FireServer(nextArtName)
					
					task.wait(1.5)
					
					-- Klik tombol OK (Claim)
					local victoryUI = screenGui and screenGui:FindFirstChild("Victory")
					if victoryUI and victoryUI:FindFirstChild("Claim") then
						fireVirtualClick(victoryUI.Claim)
					end
					
					setStatus("Sukses! Melanjutkan cycle...")
					task.wait(2) -- Jeda sebelum mencari art baru
				end
			else
				setStatus("Tidak ada Art / Uang tidak cukup")
				task.wait(3) -- Tunggu sebentar sebelum scan toko lagi
			end
		end
	end
end)
