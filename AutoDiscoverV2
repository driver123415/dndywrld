local function getTargetMonsterList()
    local list = {}
    for _, m in ipairs(Config.StandardMonsters) do
        table.insert(list, { name = m, category = "Standard" })
    end
    if Config.Discover.IncludeEventMonsters then
        for _, m in ipairs(Config.EventMonsters) do
            table.insert(list, { name = m, category = "Event" })
        end
    end
    return list
end

local function getMonsterResearchPercent(monsterName)
    local PlayerData     = ReplicatedStorage:FindFirstChild("PlayerData")
    local UserFolder     = PlayerData and PlayerData:FindFirstChild(userId)
    local ResearchFolder = UserFolder and UserFolder:FindFirstChild("Research")

    if ResearchFolder then
        local researchObj = ResearchFolder:FindFirstChild(monsterName)
        if researchObj then
            local rawVal = tostring(researchObj.Value)
            local clean  = string.gsub(rawVal, "%%", "")
            local num    = tonumber(clean)
            if num then
                return math.clamp(math.floor(num + 0.5), 0, 100)
            end
        end
    end
    return 0
end

local function getActiveMonstersInCurrentFloor()
    local activeMap = {}
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, m in ipairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") then
                activeMap[m.Name] = m
            end
        end
    end
    return activeMap
end

local function getAllTwistedResearchReport()
    local targetList  = getTargetMonsterList()
    local activeInMap = getActiveMonstersInCurrentFloor()
    local maxThresh   = Config.Discover.TargetMaxPercent or 0

    local report      = {}
    local zeroCount   = 0
    local under100    = 0
    local targetNeed  = {}

    for _, entry in ipairs(targetList) do
        local mName   = entry.name
        local pct     = getMonsterResearchPercent(mName)
        local inFloor = (activeInMap[mName] ~= nil)

        if pct == 0 then zeroCount = zeroCount + 1 end
        if pct < 100 then under100 = under100 + 1 end

        local needsDiscover = (pct <= maxThresh)
        if needsDiscover then
            table.insert(targetNeed, mName)
        end

        table.insert(report, {
            name          = mName,
            cleanName     = string.gsub(mName, "Monster$", ""),
            category      = entry.category,
            percent       = pct,
            inFloor       = inFloor,
            needsDiscover = needsDiscover
        })
    end

    table.sort(report, function(a, b)
        if a.inFloor ~= b.inFloor then return a.inFloor end
        if a.percent ~= b.percent then return a.percent < b.percent end
        return a.cleanName < b.cleanName
    end)

    return report, targetNeed, zeroCount, under100, #targetList
end

local function isMonsterDiscoveredInRealTime(monsterName, initialPercent)
    local currentPct = getMonsterResearchPercent(monsterName)
    if currentPct > (initialPercent or 0) then
        return true
    end

    local pGui        = player:FindFirstChild("PlayerGui")
    local screenGui   = pGui and pGui:FindFirstChild("ScreenGui")
    local monsterIcon = screenGui and screenGui:FindFirstChild("MonsterIcon")

    if monsterIcon and monsterIcon.Visible and type(monsterIcon.ImageTransparency) == "number" then
        if monsterIcon.ImageTransparency < 0.99 then
            return true
        end
    end

    return false
end

local function executeHitAndRun(monsterModel, loopId)
    local mPart = getMonsterPart(monsterModel)
    if not mPart then return false end

    character = player.Character
    rootPart  = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    local deadlineReached, secLeft = isPanicDeadlineReached()
    if deadlineReached then
        cprint(string.format("[SAFETY ABORT] Sisa waktu lift %s detik! Batal Hit & Run, langsung 1x TP ke Real Elevator!", tostring(secLeft)))
        ensureLockedInsideRealElevator1000Percent(false)
        return false
    end

    clearAllServerSyncedHolds()
    setTargetColliderPassable(nil, false)

    local initPct      = getMonsterResearchPercent(monsterModel.Name)
    local dist         = Config.Discover.DistanceToMonster or 15
    local heightOff    = Config.Discover.HeightOffset or 3
    local monsterPos   = mPart.Position
    local myTargetPos  = monsterPos + Vector3.new(dist, heightOff, dist)
    local lookAtCFrame = CFrame.lookAt(myTargetPos, monsterPos)

    currentStatusText = "HIT & RUN -> " .. monsterModel.Name
    cprint("[AUTO-DISCOVER] 🎯 Mengunci Target: " .. monsterModel.Name .. " (" .. initPct .. "%) via Mode: " .. tostring(Config.Teleport.Mode))

    moveCharacterTo(lookAtCFrame, true, false)
    if rootPart then rootPart.Anchored = true end

    local maxTicks = math.floor((Config.Discover.MaxWaitSeconds or 3.5) / 0.1)
    local success  = false

    for _ = 1, maxTicks do
        if isScriptDestroyed or not isAutoDiscovering or activeLoopId ~= loopId then
            if rootPart then rootPart.Anchored = false end
            restoreNormalGravity()
            return false
        end

        local isUrgent, remSec = isPanicDeadlineReached()
        if isUrgent then
            cprint(string.format("[PANIC SAFETY] Sisa waktu lift %s detik! Memutus penguncian & langsung masuk Real Elevator!", tostring(remSec)))
            break
        end

        if not monsterModel.Parent then
            break
        end

        local curMPart = getMonsterPart(monsterModel)
        if curMPart and rootPart then
            local mPos = curMPart.Position
            local tPos = mPos + Vector3.new(dist, heightOff, dist)
            rootPart.CFrame = CFrame.lookAt(tPos, mPos)
        end

        if isMonsterDiscoveredInRealTime(monsterModel.Name, initPct) then
            cprint("[AUTO-DISCOVER] ✔ Berhasil Discover: " .. monsterModel.Name .. "!")
            success = true
            break
        end

        task.wait(0.1)
    end

    discoveredThisFloor[monsterModel.Name] = true
    if rootPart then rootPart.Anchored = false end
    restoreNormalGravity()

    local panicNow = isPanicTimeActive()
    if panicNow and Config.ElevatorSafety.AlwaysLockInElevatorOnPanic then
        cprint("[AUTO-DISCOVER] 💨 Selesai Hit & Run saat Panic Time! 1x Teleport kembali ke Real Elevator...")
        ensureLockedInsideRealElevator1000Percent(true)
    else
        cprint("[AUTO-DISCOVER] 💨 Ngungsi ke tengah Thick Collider SafePlace lalu lepas...")
        moveToSafePlace()
    end

    task.wait(0.4)
    return success
end

