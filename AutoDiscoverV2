local function clearAllServerSyncedHolds()
    for _, c in ipairs(activeHoldConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(activeHoldConns)
    if currentSafePlatform and currentSafePlatform.Parent then
        pcall(function() currentSafePlatform:Destroy() end)
        currentSafePlatform = nil
    end
end

local function startServerSyncedHold(getTargetPosFn)
    clearAllServerSyncedHolds()
    if rootPart then rootPart.Anchored = false end
    Workspace.Gravity = 0

    local initPos = getTargetPosFn()
    if initPos then
        local plat = Instance.new("Part")
        plat.Name         = "_AutoDiscoverSafePlat"
        plat.Size         = Vector3.new(10, 1, 10)
        plat.Anchored     = true
        plat.CanCollide   = true
        plat.Transparency = 1
        plat.CFrame       = CFrame.new(initPos.X, initPos.Y - 3, initPos.Z)
        plat.Parent       = Workspace
        currentSafePlatform = plat
    end

    local tickCounter = 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if isScriptDestroyed or not rootPart or not isAutoDiscovering then
            if conn then conn:Disconnect() end
            return
        end
        local holdPos = getTargetPosFn()
        if not holdPos then return end
        if currentSafePlatform and currentSafePlatform.Parent then
            currentSafePlatform.CFrame = CFrame.new(holdPos.X, holdPos.Y - 3, holdPos.Z)
        end
        if (rootPart.Position - holdPos).Magnitude <= 5.0 then
            tickCounter = tickCounter + 1
            local jitterX = (tickCounter % 2 == 0) and 0.03 or -0.03
            local jitterZ = (tickCounter % 4 < 2) and 0.03 or -0.03
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = CFrame.new(holdPos.X + jitterX, holdPos.Y, holdPos.Z + jitterZ)
        end
    end)
    table.insert(activeHoldConns, conn)
    return conn
end

local function isValidThickHideCollider(col)
    if not col or not col:IsA("BasePart") then return false end
    local n = col.Name
    if n ~= "NoClip_Collider" and n ~= "CylinderCollider" then
        return false
    end

    local parent = col.Parent
    while parent and parent ~= Workspace and parent.Name ~= "CurrentRoom" do
        local pn = parent.Name:lower()
        if pn:find("wall") or pn:find("window") or pn:find("door") or pn:find("railing")
           or pn:find("fence") or pn:find("barrier") or pn:find("border") or pn:find("pillar") then
            return false
        end
        parent = parent.Parent
    end

    local wSize    = getWorldBoxSize(col)
    local minHoriz = math.min(wSize.X, wSize.Z)
    local maxHoriz = math.max(wSize.X, wSize.Z)

    if minHoriz < (Config.SafePlace.MinHideThickness or 3.5) then
        return false
    end
    if (maxHoriz / math.max(minHoriz, 0.1)) > 5.5 and minHoriz < 4.5 then
        return false
    end
    return true
end

local function updateColliderCaches(forceRebuild)
    local room = Workspace:FindFirstChild("CurrentRoom")
    local map  = getMap()
    local now  = os.clock()

    if not forceRebuild
       and map ~= nil
       and map == lastColliderScanRoom
       and #cachedHideCols > 0
       and cachedHideCols[1]
       and cachedHideCols[1].Parent ~= nil
       and (now - lastColliderScanClock) < 2.5 then
        return
    end

    lastColliderScanClock = now
    lastColliderScanRoom  = map

    local allC, hideC = {}, {}
    if room then
        for _, v in ipairs(room:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name == "NoClip" or v.Name == "NoClip_Collider" or v.Name == "CylinderCollider") then
                if not isFloorPart(v) then
                    table.insert(allC, v)
                    if isValidThickHideCollider(v) then
                        table.insert(hideC, v)
                    end
                end
            end
        end
    end
    cachedAllCols  = allC
    cachedHideCols = hideC
end

local function setTargetColliderPassable(targetCol, passable)
    if passable and targetCol and targetCol.Parent then
        local room = Workspace:FindFirstChild("CurrentRoom")
        local map  = getMap()

        local function disablePart(p)
            if p and p:IsA("BasePart") and not isFloorPart(p) then
                if tempHideCollideStates[p] == nil then
                    tempHideCollideStates[p] = p.CanCollide
                end
                p.CanCollide = false
            end
        end

        disablePart(targetCol)
        local parentObj = targetCol.Parent
        if parentObj and parentObj ~= room and parentObj ~= map then
            if parentObj:IsA("BasePart") then disablePart(parentObj) end
            for _, d in ipairs(parentObj:GetDescendants()) do
                disablePart(d)
            end
        end
    elseif not passable then
        for p, orig in pairs(tempHideCollideStates) do
            if p and p.Parent then p.CanCollide = orig end
        end
        table.clear(tempHideCollideStates)
    end
end

local function getMinDistanceToMonsters(pt)
    local minDist = math.huge
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") then
                local p = getMonsterPart(m)
                if p then
                    local d = (p.Position - pt).Magnitude
                    if d < minDist then minDist = d end
                end
            end
        end
    end
    return minDist
end

local function getBestThickColliderCenter()
    updateColliderCaches(false)
    if #cachedHideCols == 0 then return nil, nil end

    local walkY = getSafeWalkY(rootPart and rootPart.Position.Y or 100)
    local bestCol, bestCenter, bestMobDist = nil, nil, -1

    for _, col in ipairs(cachedHideCols) do
        if col and col.Parent then
            local center = Vector3.new(col.Position.X, walkY, col.Position.Z)
            local mobDist = getMinDistanceToMonsters(center)
            if mobDist > bestMobDist then
                bestMobDist = mobDist
                bestCol     = col
                bestCenter  = center
            end
        end
    end

    return bestCenter, bestCol
end

-- 1. Metode Instant Teleport
local function teleportInstant(cf, keepZeroGravity)
    character = player.Character
    rootPart  = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    rootPart.Anchored = false
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity  = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.CFrame = cf
    if character then character:PivotTo(cf) end
    if not keepZeroGravity then
        restoreNormalGravity()
    end
end

-- 2. Metode Dual-Speed Tween (3.50 Open / 1.05 Obstacle)
local function teleportTween(cf, customSpeed, keepZeroGravity)
    character = player.Character
    rootPart  = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    rootPart.Anchored = false
    Workspace.Gravity = 0

    local startPos   = rootPart.Position
    local targetPos  = cf.Position
    local baseSpd    = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
    local openMult   = customSpeed or Config.Teleport.TweenSpeed or 3.50
    local noclipMult = Config.Teleport.NoClipTweenSpeed or 1.05

    updateColliderCaches(false)
    local nearObstacle = false
    local midPt = startPos:Lerp(targetPos, 0.5)
    for _, col in ipairs(cachedAllCols) do
        if col and col.Parent then
            if isPointInsideExpandedBox(midPt, col, 4.0, 2.5) or isPointInsideExpandedBox(targetPos, col, 4.0, 2.5) then
                nearObstacle = true
                setTargetColliderPassable(col, true)
            end
        end
    end

    local moveSpd = baseSpd * (nearObstacle and noclipMult or openMult)
    local dist    = (startPos - targetPos).Magnitude
    local dur     = math.max(dist / math.max(moveSpd, 1), 0.001)

    local tw = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
    activeTween = tw
    tw:Play()

    local done = false
    tw.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed then done = true end
    end)

    while not done and isAutoDiscovering and not abortCurrentMovement and not isScriptDestroyed do
        if isPanicDeadlineReached() then
            tw:Cancel()
            break
        end
        task.wait(0.015)
    end

    if rootPart and (rootPart.Position - targetPos).Magnitude <= 4.5 then
        rootPart.CFrame = cf
        if character then character:PivotTo(cf) end
    end
    if rootPart then
        rootPart.AssemblyLinearVelocity  = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end
    if activeTween == tw then activeTween = nil end

    if not keepZeroGravity then
        restoreNormalGravity()
    end
    return true
end

-- 3. Metode Hybrid Y-Bypass (Turun ke Y = -241 lalu loncat ke tujuan)
local function teleportHybridY(cf, keepZeroGravity)
    character = player.Character
    rootPart  = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local flatDist = Vector2.new(rootPart.Position.X - cf.Position.X, rootPart.Position.Z - cf.Position.Z).Magnitude
    local minDist  = Config.Teleport.HybridMinDistance or 75

    if flatDist < minDist then
        teleportTween(cf, Config.Teleport.TweenSpeed, keepZeroGravity)
        return
    end

    local colCenter, targetCol = getBestThickColliderCenter()
    if colCenter and targetCol then
        setTargetColliderPassable(targetCol, true)
        teleportTween(CFrame.new(colCenter), Config.Teleport.TweenSpeed, true)
    end

    local anchorPos = rootPart and rootPart.Position or cf.Position
    local bypassY   = Config.Teleport.HybridBypassY or -241
    local waitDelay = math.max(Config.Teleport.HybridBypassDelay or 0.40, 0.05)
    local bypassCF  = CFrame.new(anchorPos.X, bypassY, anchorPos.Z)

    Workspace.Gravity = 0
    teleportInstant(bypassCF, true)

    local holdConn = RunService.Heartbeat:Connect(function()
        if rootPart and isAutoDiscovering and not abortCurrentMovement and not isScriptDestroyed then
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = bypassCF
        end
    end)

    local elapsed = 0
    while elapsed < waitDelay and isAutoDiscovering and not abortCurrentMovement and not isScriptDestroyed do
        if isPanicDeadlineReached() then break end
        local step = math.min(0.05, waitDelay - elapsed)
        task.wait(step)
        elapsed = elapsed + step
    end

    if holdConn then holdConn:Disconnect() end

    teleportInstant(cf, true)
    task.wait(0.04)
    teleportInstant(cf, keepZeroGravity)
end

-- Router Utama Perpindahan Karakter (Mengikuti Config.Teleport.Mode)
local function moveCharacterTo(cf, keepZeroGravity, forceInstant)
    if forceInstant then
        teleportInstant(cf, keepZeroGravity)
        return
    end

    local mode = string.lower(tostring(Config.Teleport.Mode or "instant"))
    if mode == "tween" then
        teleportTween(cf, Config.Teleport.TweenSpeed, keepZeroGravity)
    elseif mode == "hybridy" then
        teleportHybridY(cf, keepZeroGravity)
    else
        teleportInstant(cf, keepZeroGravity)
    end
end

-- Menentukan titik tengah kabin Real Elevator
local function getRealElevatorCFrame()
    local walkY  = (rootPart and rootPart.Position.Y > -50 and rootPart.Position.Y < 200) and rootPart.Position.Y or nil
    local curMap = getMap()
    local depth  = Config.ElevatorSafety.CabinInwardDepth or 8.0

    local elevatorsFolder = Workspace:FindFirstChild("Elevators")
    if elevatorsFolder then
        for _, obj in ipairs(elevatorsFolder:GetChildren()) do
            if obj.Name == "Elevator" and obj:IsA("Model") then
                for _, desc in ipairs(obj:GetDescendants()) do
                    if desc:IsA("BasePart") and not isFloorPart(desc) then
                        local ln = desc.Name:lower()
                        if ln == "doorhitbox" or ln:find("door") or ln:find("gate") or ln:find("invis") then
                            desc.CanCollide = false
                        end
                    end
                end

                local centerPos  = (obj.PrimaryPart and obj.PrimaryPart.Position) or getModelCenter(obj)
                local doorHitbox = obj:FindFirstChild("DoorHitbox", true)
                if centerPos and doorHitbox then
                    local dPos = doorHitbox:IsA("BasePart") and doorHitbox.Position or doorHitbox:GetPivot().Position
                    local inwardDir = Vector3.new(centerPos.X - dPos.X, 0, centerPos.Z - dPos.Z)
                    if inwardDir.Magnitude > 0.5 then
                        inwardDir = inwardDir.Unit
                        local safeCabinPos = Vector3.new(dPos.X, centerPos.Y, dPos.Z) + (inwardDir * depth)
                        cachedRealElevCF   = CFrame.new(safeCabinPos.X, safeCabinPos.Y + 3, safeCabinPos.Z)
                        cachedRealElevRoom = curMap
                        return CFrame.new(safeCabinPos.X, walkY or (safeCabinPos.Y + 3), safeCabinPos.Z)
                    end
                end
                if centerPos then
                    cachedRealElevCF   = CFrame.new(centerPos.X, centerPos.Y + 3, centerPos.Z)
                    cachedRealElevRoom = curMap
                    return CFrame.new(centerPos.X, walkY or (centerPos.Y + 3), centerPos.Z)
                end
            end
        end
        for _, obj in ipairs(elevatorsFolder:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                cachedRealElevCF   = cf
                cachedRealElevRoom = curMap
                return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
            end
        end
    end

    local room = Workspace:FindFirstChild("CurrentRoom")
    if room then
        for _, obj in ipairs(room:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local parentName = string.lower(obj.Parent and obj.Parent.Name or "")
                if not string.find(parentName, "fake") then
                    local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                    cachedRealElevCF   = cf
                    cachedRealElevRoom = curMap
                    return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
                end
            end
        end
    end

    if cachedRealElevCF and cachedRealElevRoom == curMap then
        return CFrame.new(cachedRealElevCF.X, walkY or cachedRealElevCF.Y, cachedRealElevCF.Z)
    end
    return nil
end

-- Fungsi Masuk Real Elevator (Hanya jalan jika diizinkan oleh Config!)
local function ensureLockedInsideRealElevator1000Percent(forceRetrigger)
    -- GUARD UTAMA: Jika AlwaysLockInElevatorOnPanic = false dan SafePlace bukan RealElevator, TOLAK semua teleport ke lift!
    if not Config.ElevatorSafety.AlwaysLockInElevatorOnPanic and Config.SafePlace.Mode ~= "RealElevator" then
        return false
    end

    if forceRetrigger then
        hasEnteredElevatorThisFloor = false
    end

    if Config.ElevatorSafety.OneTimeTeleportOnly and hasEnteredElevatorThisFloor then
        currentStatusText = "SUDAH 1X TP KE LIFT (BEBAS GERAK)"
        return true
    end

    clearAllServerSyncedHolds()
    setTargetColliderPassable(nil, false)
    restoreNormalGravity()

    character = player.Character
    rootPart  = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    rootPart.Anchored = false
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum.Sit = false
    end

    local elevCF = getRealElevatorCFrame()
    if not elevCF then return false end

    if Config.ElevatorSafety.OneTimeTeleportOnly then
        for _ = 1, 3 do
            teleportInstant(elevCF, false)
            task.wait(0.12)
            character = player.Character
            rootPart  = character and character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local checkDist = Vector2.new(rootPart.Position.X - elevCF.Position.X, rootPart.Position.Z - elevCF.Position.Z).Magnitude
                if checkDist <= 11.0 then
                    hasEnteredElevatorThisFloor = true
                    rootPart.Anchored = false
                    restoreNormalGravity()
                    cprint("[ELEVATOR 1X TRIGGER] ✔ Terverifikasi masuk Real Elevator! Trigger selesai (karakter bebas gerak).")
                    currentStatusText = "SUDAH 1X TP KE LIFT (BEBAS GERAK)"
                    return true
                end
            end
        end
        hasEnteredElevatorThisFloor = true
        return true
    else
        local flatDist = Vector2.new(rootPart.Position.X - elevCF.Position.X, rootPart.Position.Z - elevCF.Position.Z).Magnitude
        local maxDrift = Config.ElevatorSafety.MaxAllowedDrift or 5.5
        if flatDist > maxDrift or math.abs(rootPart.Position.Y - elevCF.Position.Y) > 8 then
            teleportInstant(elevCF, false)
            cprint("[ELEVATOR LOCK] Memastikan posisi tepat di dalam kabin Real Elevator!")
        end
        currentStatusText = "LOCK PERMANEN DI REAL ELEVATOR"
        return true
    end
end

-- Fungsi Ngungsi ke SafePlace (Patuh penuh pada AlwaysLockInElevatorOnPanic)
local function moveToSafePlace()
    clearAllServerSyncedHolds()
    character = player.Character
    rootPart  = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    rootPart.Anchored = false

    local panicNow = isPanicTimeActive()
    local useElevator = (Config.SafePlace.Mode == "RealElevator")
        or (panicNow and Config.ElevatorSafety.AlwaysLockInElevatorOnPanic)

    if useElevator then
        return ensureLockedInsideRealElevator1000Percent(true)
    end

    local colCenter, targetCol = getBestThickColliderCenter()
    if colCenter and targetCol then
        local colName = (targetCol.Parent and targetCol.Parent.Name or targetCol.Name)
        currentStatusText = "NGUNGSI KE COLLIDER (" .. colName .. ")"
        setTargetColliderPassable(targetCol, true)
        moveCharacterTo(CFrame.new(colCenter), true, false)

        local holdSec = Config.SafePlace.HoldAfterHitSeconds or 0.8
        if holdSec > 0 then
            startServerSyncedHold(function() return colCenter end)
            task.wait(holdSec)
            clearAllServerSyncedHolds()
        end

        restoreNormalGravity()
        if rootPart then rootPart.Anchored = false end
        currentStatusText = "SAFE DI COLLIDER (BEBAS GERAK)"
        return true
    end

    return false
end

