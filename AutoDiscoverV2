-- [SECTION 7] MAIN AUTO-DISCOVER LOOP (STRICT ELEVATOR TOGGLE)
-- ==============================================================================
local function startAutoDiscover()
    activeLoopId = activeLoopId + 1
    local myLoopId = activeLoopId

    task.spawn(function()
        while isAutoDiscovering and activeLoopId == myLoopId and not isScriptDestroyed do
            character = player.Character
            rootPart  = character and character:FindFirstChild("HumanoidRootPart")

            if not rootPart then
                currentStatusText = "MENUNGGU KARAKTER SPAWN..."
                task.wait(0.5)
                continue
            end

            local map = getMap()
            local _, undiscoveredList = getAllTwistedResearchReport()

            if #undiscoveredList == 0 then
                cprint("==================================================")
                cprint("🎉 SELAMAT! Semua Monster Target di Config sudah ter-Discover!")
                cprint("==================================================")
                currentStatusText = "SEMUA TWISTED SELESAI!"
                if Config.ElevatorSafety.AlwaysLockInElevatorOnPanic and isPanicTimeActive() and not hasEnteredElevatorThisFloor then
                    ensureLockedInsideRealElevator1000Percent(false)
                end
                toggleBtn.Text = "SEMUA SELESAI"
                toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
                refreshDashboardGUI()
                task.wait(1)
                continue
            end

            -- Hanya aktif jika AlwaysLockInElevatorOnPanic == true
            local panicUrgent, remSec = isPanicDeadlineReached()
            if panicUrgent then
                if not hasEnteredElevatorThisFloor or not Config.ElevatorSafety.OneTimeTeleportOnly then
                    ensureLockedInsideRealElevator1000Percent(false)
                end
                currentStatusText = string.format("SELESAI 1X TP KE LIFT (SISA %ds)", remSec or 0)
                refreshDashboardGUI()
                task.wait(0.25)
                continue
            end

            local triggerAllowed, triggerReason = isTriggerConditionMet()
            if not triggerAllowed then
                currentStatusText = "STANDBY: " .. triggerReason
                refreshDashboardGUI()
                task.wait(0.4)
                continue
            end

            local foundTargetToHit = nil
            if map then
                local monstersFolder = map:FindFirstChild("Monsters")
                if monstersFolder then
                    for _, monsterModel in pairs(monstersFolder:GetChildren()) do
                        if monsterModel:IsA("Model") and getMonsterPart(monsterModel) then
                            local isNeeded = false
                            for _, targetName in ipairs(undiscoveredList) do
                                if monsterModel.Name == targetName then
                                    isNeeded = true
                                    break
                                end
                            end

                            if isNeeded and not discoveredThisFloor[monsterModel.Name] then
                                foundTargetToHit = monsterModel
                                break
                            end
                        end
                    end
                end
            end

            if foundTargetToHit then
                refreshDashboardGUI()
                executeHitAndRun(foundTargetToHit, myLoopId)
                refreshDashboardGUI()
            else
                local panicNow, secLeft = isPanicTimeActive()
                if panicNow and Config.ElevatorSafety.AlwaysLockInElevatorOnPanic then
                    if not hasEnteredElevatorThisFloor or not Config.ElevatorSafety.OneTimeTeleportOnly then
                        ensureLockedInsideRealElevator1000Percent(false)
                    end
                    currentStatusText = "SUDAH 1X TP KE LIFT" .. (secLeft and (" (" .. secLeft .. "s)") or "")
                else
                    currentStatusText = "AMAN (TIDAK ADA TARGET BARU DI LANTAI INI)"
                end
                refreshDashboardGUI()
                task.wait(0.3)
            end
        end
    end)
end

task.spawn(function()
    while not isScriptDestroyed and screenGui and screenGui.Parent do
        pcall(refreshDashboardGUI)
        task.wait(1.0)
    end
end)

