-- Fungsi Render Daftar Twisted di GUI
local function refreshDashboardGUI()
    if isScriptDestroyed or not screenGui or not screenGui.Parent then return end

    local report, _, zeroCount, under100, totalCount = getAllTwistedResearchReport()
    local curGen, totGen = getMachineProgress()
    local panicNow, secLeft = isPanicTimeActive()
    local trigOk, trigDesc = isTriggerConditionMet()

    statusLine1.Text = "STATUS: " .. currentStatusText
    statusLine1.TextColor3 = isAutoDiscovering and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(255, 120, 120)

    local timerTxt = secLeft and (tostring(secLeft) .. "s (PANIC!)") or (panicNow and "PANIC ACTIVE" or "Normal")
    statusLine2.Text = string.format("Mesin: %d/%d | Lift: %s | %s", curGen, totGen, timerTxt, trigDesc)
    statusLine2.TextColor3 = trigOk and Color3.fromRGB(130, 240, 255) or Color3.fromRGB(210, 210, 210)

    statusLine3.Text = string.format("Kurang 0%% (Belum Discover): %d  |  Kurang <100%%: %d / %d", zeroCount, under100, totalCount)

    for _, child in ipairs(listScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local shownCount = 0
    for idx, item in ipairs(report) do
        local showThis = false
        if guiFilterMode == "ZERO" then
            showThis = (item.percent == 0)
        elseif guiFilterMode == "INCOMPLETE" then
            showThis = (item.percent < 100)
        else
            showThis = true
        end

        if showThis then
            shownCount = shownCount + 1
            local row = Instance.new("Frame")
            row.Name             = item.name
            row.LayoutOrder      = idx
            row.Size             = UDim2.new(1, 0, 0, 28)
            row.BackgroundColor3 = item.inFloor and Color3.fromRGB(60, 50, 18) or Color3.fromRGB(24, 28, 38)
            row.BorderSizePixel  = 0
            row.Parent           = listScroll
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

            if item.inFloor then
                local st = Instance.new("UIStroke", row)
                st.Color = Color3.fromRGB(255, 215, 0)
                st.Thickness = 1.2
            end

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size                   = UDim2.new(0.68, -8, 1, 0)
            nameLbl.Position               = UDim2.new(0, 8, 0, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Font                   = Enum.Font.GothamBold
            nameLbl.TextSize               = 11
            nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
            nameLbl.TextColor3             = item.inFloor and Color3.fromRGB(255, 230, 80)
                                          or (item.percent == 0 and Color3.fromRGB(255, 110, 110)
                                          or (item.percent == 100 and Color3.fromRGB(100, 255, 140)
                                          or Color3.fromRGB(230, 230, 240)))

            local prefix = item.inFloor and "🔥 [DI LANTAI INI] " or (item.category == "Event" and "🎃 " or "• ")
            nameLbl.Text = prefix .. item.cleanName
            nameLbl.Parent = row

            local pctLbl = Instance.new("TextLabel")
            pctLbl.Size                   = UDim2.new(0.32, -8, 1, 0)
            pctLbl.Position               = UDim2.new(0.68, 0, 0, 0)
            pctLbl.BackgroundTransparency = 1
            pctLbl.Font                   = Enum.Font.GothamBold
            pctLbl.TextSize               = 11
            pctLbl.TextXAlignment         = Enum.TextXAlignment.Right
            pctLbl.TextColor3             = (item.percent == 0) and Color3.fromRGB(255, 95, 95)
                                         or (item.percent >= 100 and Color3.fromRGB(80, 255, 130)
                                         or Color3.fromRGB(255, 205, 80))
            pctLbl.Text                   = tostring(item.percent) .. "%"
            pctLbl.Parent                 = row
        end
    end

    if shownCount == 0 then
        local emptyLbl = Instance.new("TextLabel")
        emptyLbl.Size                   = UDim2.new(1, 0, 0, 40)
        emptyLbl.BackgroundTransparency = 1
        emptyLbl.Font                   = Enum.Font.GothamBold
        emptyLbl.TextSize               = 12
        emptyLbl.TextColor3             = Color3.fromRGB(100, 255, 150)
        emptyLbl.Text                   = "🎉 Semua Twisted pada kategori ini sudah selesai!"
        emptyLbl.Parent                 = listScroll
    end
end

