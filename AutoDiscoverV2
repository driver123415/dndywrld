local function getMap()
    local cr = Workspace:FindFirstChild("CurrentRoom")
    local m  = cr and cr:FindFirstChildWhichIsA("Model")
    if m and m ~= currentMapInstance then
        currentMapInstance          = m
        cachedRealElevCF            = nil
        cachedRealElevRoom          = nil
        hasEnteredElevatorThisFloor = false
        table.clear(discoveredThisFloor)
    end
    return m
end

local function getModelCenter(model)
    if not model or not model:IsA("Model") then return nil end
    local total, n = Vector3.zero, 0
    for _, p in pairs(model:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "DoorHitbox" then
            total = total + p.Position
            n = n + 1
        end
    end
    return n > 0 and (total / n) or nil
end

local function getMonsterPart(monster)
    if not monster or not monster:IsA("Model") then return nil end
    return monster.PrimaryPart
        or monster:FindFirstChild("HumanoidRootPart")
        or monster:FindFirstChildWhichIsA("BasePart", true)
end

local function getWorldBoxSize(part)
    local cf = part.CFrame
    local sz = part.Size
    local wx = math.abs(cf.RightVector.X) * sz.X + math.abs(cf.UpVector.X) * sz.Y + math.abs(cf.LookVector.X) * sz.Z
    local wy = math.abs(cf.RightVector.Y) * sz.X + math.abs(cf.UpVector.Y) * sz.Y + math.abs(cf.LookVector.Y) * sz.Z
    local wz = math.abs(cf.RightVector.Z) * sz.X + math.abs(cf.UpVector.Z) * sz.Y + math.abs(cf.LookVector.Z) * sz.Z
    return Vector3.new(wx, wy, wz)
end

local function getSafeWalkY(referenceY)
    if rootPart and rootPart.Position.Y > -50 and rootPart.Position.Y < 200 then
        return rootPart.Position.Y
    end
    return referenceY or 100
end

local function isFloorPart(p)
    if not p or not p:IsA("BasePart") then return true end
    local ln = p.Name:lower()
    if ln:find("floor") or ln:find("ground") or ln:find("baseplate") or ln:find("carpet")
       or ln:find("pedestal") or ln:find("stageouter") or ln:find("stageinner") or ln:find("stair") or ln:find("ramp") then
        return true
    end
    local parent = p.Parent
    while parent and parent ~= Workspace and parent.Name ~= "CurrentRoom" do
        local pn = parent.Name:lower()
        if pn == "floor" or pn:find("floor") or pn:find("ground") or pn:find("pedestal") or pn:find("stair") then
            return true
        end
        parent = parent.Parent
    end
    if p.Size.Y < 2.5 and p.Size.X > 25 and p.Size.Z > 25 and rootPart and p.Position.Y < (rootPart.Position.Y - 1.5) then
        return true
    end
    return false
end

local function isPointInsideExpandedBox(pt, part, marginXZ, marginY)
    if not part or not part:IsA("BasePart") then return false end
    marginXZ  = marginXZ or 0
    marginY   = marginY or marginXZ
    local lPt = part.CFrame:PointToObjectSpace(pt)
    return math.abs(lPt.X) <= (part.Size.X * 0.5 + marginXZ)
       and math.abs(lPt.Y) <= (part.Size.Y * 0.5 + marginY)
       and math.abs(lPt.Z) <= (part.Size.Z * 0.5 + marginXZ)
end

local function getMachineProgress()
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        local specGui  = pGui:FindFirstChild("SpectatorGui")
        local info     = specGui and specGui:FindFirstChild("InfoFrame")
        local genFrame = info and info:FindFirstChild("GeneratorFrame")
        local msg      = genFrame and genFrame:FindFirstChild("Message")
        if msg and msg:IsA("TextLabel") then
            local cur, tot = string.match(msg.Text, "Machines Completed: (%d+)/(%d+)")
            if cur and tot then
                return tonumber(cur), tonumber(tot)
            end
        end
        for _, gui in ipairs(pGui:GetChildren()) do
            local topBar = gui:FindFirstChild("TopBar", true)
            local gf     = (topBar and topBar:FindFirstChild("GeneratorFrame")) or gui:FindFirstChild("GeneratorFrame", true)
            local m      = gf and gf:FindFirstChild("Message")
            if m and m:IsA("TextLabel") then
                local cur, tot = string.match(m.Text, "Machines Completed: (%d+)/(%d+)")
                if cur and tot then
                    return tonumber(cur), tonumber(tot)
                end
            end
        end
    end

    local map = getMap()
    local genFolder = map and map:FindFirstChild("Generators")
    if genFolder then
        local doneCount, totalCount = 0, 0
        for _, gen in ipairs(genFolder:GetChildren()) do
            if gen:IsA("Model") then
                totalCount = totalCount + 1
                local stats = gen:FindFirstChild("Stats")
                if stats and stats:FindFirstChild("Completed") and stats.Completed.Value then
                    doneCount = doneCount + 1
                end
            end
        end
        if totalCount > 0 then
            return doneCount, totalCount
        end
    end

    return 0, 0
end

local function getElevatorCountdownSeconds()
    local pGui = player:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    local screenGui = pGui:FindFirstChild("ScreenGui")
    local menu      = screenGui and screenGui:FindFirstChild("Menu")
    local topBar    = menu and menu:FindFirstChild("TopBar")
    local msgLabel  = topBar and topBar:FindFirstChild("Message")

    if msgLabel and msgLabel:IsA("TextLabel") and msgLabel.Visible then
        local sec = string.match(msgLabel.Text, "Elevator leaves in (%d+)")
            or string.match(string.lower(msgLabel.Text), "leaves in (%d+)")
        if sec then
            return tonumber(sec)
        end
    end

    for _, gui in ipairs(pGui:GetChildren()) do
        local tb = gui:FindFirstChild("TopBar", true) or gui:FindFirstChild("InfoFrame", true)
        if tb then
            for _, d in ipairs(tb:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local sec = string.match(d.Text, "Elevator leaves in (%d+)")
                        or string.match(string.lower(d.Text), "leaves in (%d+)")
                    if sec then
                        return tonumber(sec)
                    end
                end
            end
        end
    end
    return nil
end

local function isPanicTimeActive()
    local secLeft = getElevatorCountdownSeconds()
    if secLeft ~= nil then
        return true, secLeft
    end
    local curGen, totGen = getMachineProgress()
    if totGen > 0 and curGen >= totGen then
        return true, nil
    end
    return false, nil
end

-- Hanya mengembalikan true JIKA AlwaysLockInElevatorOnPanic = true DAN waktu lift <= PanicDeadlineSeconds
local function isPanicDeadlineReached()
    if not Config.ElevatorSafety.AlwaysLockInElevatorOnPanic then
        return false, getElevatorCountdownSeconds()
    end
    local secLeft = getElevatorCountdownSeconds()
    local deadline = Config.ElevatorSafety.PanicDeadlineSeconds or 7
    if secLeft ~= nil and secLeft <= deadline then
        return true, secLeft
    end
    return false, secLeft
end

local function isTriggerConditionMet()
    local mode = string.lower(tostring(Config.TriggerRules.Mode or "machinecount"))
    local minReq = Config.TriggerRules.MinMachinesCompleted or 2
    local curGen, totGen = getMachineProgress()
    local panicNow, secLeft = isPanicTimeActive()

    if mode == "always" then
        return true, "Always Active"
    elseif mode == "panictime" then
        if panicNow then
            return true, "Panic Time Aktif" .. (secLeft and (" (" .. secLeft .. "s)") or "")
        end
        return false, string.format("Menunggu Panic Time (Mesin: %d/%d)", curGen, totGen)
    elseif mode == "machinecount" then
        if curGen >= minReq or panicNow then
            return true, string.format("Target Mesin Terpenuhi (%d/%d >= %d)", curGen, totGen, minReq)
        end
        return false, string.format("Menunggu %d Mesin Selesai (Sekarang: %d/%d)", minReq, curGen, totGen)
    elseif mode == "either" then
        if panicNow then
            return true, "Panic Time Aktif" .. (secLeft and (" (" .. secLeft .. "s)") or "")
        elseif curGen >= minReq then
            return true, string.format("Target Mesin Terpenuhi (%d/%d >= %d)", curGen, totGen, minReq)
        end
        return false, string.format("Menunggu %d Mesin / Panic Time (%d/%d)", minReq, curGen, totGen)
    end

    return panicNow, "Menunggu Trigger"
end

