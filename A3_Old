-- =======================================================
-- SMART JSON REWRITE FUNCTION
-- Membandingkan isi tabel JSON secara langsung (kebal urutan teks acak)
-- =======================================================
local function isTableEqual(t1, t2)
    if type(t1) ~= "table" or type(t2) ~= "table" then return t1 == t2 end
    for k, v in pairs(t1) do
        if t2[k] ~= v then return false end
    end
    for k, v in pairs(t2) do
        if t1[k] ~= v then return false end
    end
    return true
end

local function smartWriteJSON(filePath, targetTable)
    if not writefile then
        warn("[AutoConfig] Executor tidak mendukung fungsi writefile!")
        return
    end

    local needWrite = true

    -- Cek apakah file sudah ada dan bandingkan isi datanya
    if isfile and readfile and isfile(filePath) then
        local success, currentContent = pcall(readfile, filePath)
        if success and currentContent then
            local decodeOk, currentTable = pcall(function()
                return HttpService:JSONDecode(currentContent)
            end)
            -- Jika isi key dan value di dalam JSON sudah sama persis, tidak perlu rewrite
            if decodeOk and type(currentTable) == "table" then
                if isTableEqual(currentTable, targetTable) then
                    needWrite = false
                end
            end
        end
    end

    -- Tulis file hanya jika memang ada nilai settingan yang berubah
    if needWrite then
        local okEncode, jsonString = pcall(function()
            return HttpService:JSONEncode(targetTable)
        end)
        if okEncode then
            local okWrite, err = pcall(writefile, filePath, jsonString)
            if okWrite then
                print("[AutoConfig] File diperbarui: " .. filePath)
            else
                warn("[AutoConfig] Gagal menulis " .. filePath .. ": " .. tostring(err))
            end
        end
    else
        print("[AutoConfig] Skip Rewrite (Data sudah sama): " .. filePath)
    end
end

