local function jalankanBSGUI()
    local success, err = pcall(function()
        local loaderFunc = loadstring(game:HttpGet(LOADER_URL))
        if type(loaderFunc) == "function" then
            loaderFunc(LOADER_ARGS)
        else
            error("Loader tidak mengembalikan function yang valid.")
        end
    end)
    if not success then
        warn("[AutoLoad] Gagal memuat BSGUI: " .. tostring(err))
    end
end

