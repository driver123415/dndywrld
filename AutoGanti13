-- ==========================================
-- =         HELPER: VIRTUAL CLICK GUI      =
-- ==========================================
local function virtualClickButton(button)
    if not button then return end
    local inset = GuiService:GetGuiInset()
    local pos = button.AbsolutePosition
    local size = button.AbsoluteSize
    local cx = pos.X + size.X / 2
    local cy = pos.Y + size.Y / 2 + inset.Y
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
end

local function fireButton(button, useVirtual)
    if not button then return end
    if useVirtual then
        virtualClickButton(button)
    else
        pcall(function()
            if getconnections then
                for _, c in ipairs(getconnections(button.MouseButton1Click)) do c:Fire() end
                for _, c in ipairs(getconnections(button.Activated)) do c:Fire() end
            elseif firesignal then
                firesignal(button.MouseButton1Click)
                firesignal(button.Activated)
            end
        end)
    end
end

