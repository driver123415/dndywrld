local function correctTrinketsEquipped()
    local equippedTrinkets = {}
    for i = 1, 2 do
        local slot      = MainGui:FindFirstChild("Slot" .. i)
        local itemImage = slot and slot:FindFirstChild("ItemImage")
        if itemImage and itemImage.Visible then
            for trinketName, assetId in pairs(Config.TrinketsToUse) do
                if itemImage.Image == assetId then
                    table.insert(equippedTrinkets, trinketName)
                end
            end
        end
    end

    print("🔎 Trinket terpasang: " .. (next(equippedTrinkets) and table.concat(equippedTrinkets, ", ") or "kosong"))

    for trinketName, _ in pairs(Config.TrinketsToUse) do
        local found = false
        for _, have in ipairs(equippedTrinkets) do
            if have == trinketName then found = true break end
        end
        if not found then return false end
    end
    return true
end

