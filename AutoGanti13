local function getIndicatorCount(buttonPath)
    local indicator = buttonPath and buttonPath:FindFirstChild("NewIndicator")
    if not indicator or not indicator.Visible then return 0 end
    local label = indicator:FindFirstChild("TextLabel")
    if label then return tonumber(label.Text) or 0 end
    return 0
end

