local function extractNumber(text)
    if text and type(text) == "string" then
        local num = string.match(string.gsub(text, ",", ""), "%d+")
        return num and tonumber(num) or nil
    end
    return nil
end

local function virtualClickButton(button)
    if not button then return end
    local inset = GuiService:GetGuiInset()
    local pos   = button.AbsolutePosition
    local size  = button.AbsoluteSize
    VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2 + inset.Y, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2 + inset.Y, 0, false, game, 0)
end

local function fireButton(button)
    if not button then return end
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(button.MouseButton1Click)) do c:Fire() end
            for _, c in ipairs(getconnections(button.Activated)) do c:Fire() end
        elseif firesignal then
            firesignal(button.MouseButton1Click)
            firesignal(button.Activated)
        end
    end)
end

local function getMonsterButton()
    local menu = MainGui:FindFirstChild("Menu")
    local left = menu and menu:FindFirstChild("LeftSide")
    return left and left:FindFirstChild("MonsterButton")
end

local function getJournalButton()
    local menu = MainGui:FindFirstChild("Menu")
    local left = menu and menu:FindFirstChild("LeftSide")
    return left and left:FindFirstChild("DreamJournalButton")
end

local function getIndicatorCount(btn)
    local indicator = btn and btn:FindFirstChild("NewIndicator")
    if not indicator or not indicator.Visible then return 0 end
    local label = indicator:FindFirstChild("TextLabel")
    return label and tonumber(label.Text) or 0
end

local function getCurrentlyUsedToon()
    local myCharInfo = nil
    local wsPlayers  = Workspace:FindFirstChild("Players")
    if wsPlayers then myCharInfo = wsPlayers:FindFirstChild(LocalPlayer.Name) end
    if not myCharInfo then myCharInfo = LocalPlayer.Character end
    if not myCharInfo then myCharInfo = Workspace:FindFirstChild(LocalPlayer.Name) end
    if myCharInfo then
        local conf = myCharInfo:FindFirstChild("Config")
        if conf then
            local charName = conf:FindFirstChild("CharacterName") or conf:FindFirstChild("ModuleName")
            if charName and charName.ClassName == "StringValue" and charName.Value ~= "" then
                return string.split(charName.Value, "_")[1] or "Unknown"
            end
        end
    end
    return "Unknown"
end

