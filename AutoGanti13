            end
        end
        task.wait(1.5)
    end

else
    -- ==========================================
    -- =     LOGIKA FALLBACK & ATURAN NABUNG    =
    -- ==========================================
    if tutorialSkipped then
        print("Tutorial baru di-skip. Melewati logika Newbie...")
    else
        print("Target Twisted BELUM terpenuhi. Cek kondisi Newbie...")

        if game.PlaceId == LOBBY_PLACE_ID then
            local rodgerUI    = charScrollFrame:FindFirstChild(FallbackConfig.ToonToBuy)
            local ownsRodger  = (rodgerUI and rodgerUI.Visible == true)
            local ichorLabel  = MainGui:FindFirstChild("Info")
                and MainGui.Info:FindFirstChild("IchorFrame")
                and MainGui.Info.IchorFrame:FindFirstChild("TextLabel")
            local currentIchor = ichorLabel and extractNumber(ichorLabel.Text) or 0

            local ChangeCharEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("ChangeChar")
            local currentToon     = getCurrentlyUsedToon()

            if not ownsRodger then
                local tutToon = FallbackConfig.TutorialToon
                if currentToon ~= tutToon then
                    local toonData = ReplicatedStorage:WaitForChild("SharedData"):WaitForChild("TowerData"):FindFirstChild(tutToon)
                    if toonData then pcall(function() ChangeCharEvent:FireServer(toonData) end) end
                    task.wait(1)
                end
                if currentIchor >= FallbackConfig.ToonCost then
                    print("Membeli Toon: " .. FallbackConfig.ToonToBuy)
                    pcall(function() BuyTower:InvokeServer(FallbackConfig.ToonToBuy) end)
                    task.wait(1.5)
                    currentIchor -= FallbackConfig.ToonCost
                    ownsRodger = true
                    local toonData = ReplicatedStorage:WaitForChild("SharedData"):WaitForChild("TowerData"):FindFirstChild(FallbackConfig.ToonToBuy)
                    if toonData then pcall(function() ChangeCharEvent:FireServer(toonData) end) end
                    task.wait(1)
                else
                    print("Ichor belum cukup (" .. currentIchor .. "/1000). NABUNG DULU!")
                end
            end

            if ownsRodger then
                if currentToon ~= FallbackConfig.ToonToBuy then
                    local toonData = ReplicatedStorage:WaitForChild("SharedData"):WaitForChild("TowerData"):FindFirstChild(FallbackConfig.ToonToBuy)
                    if toonData then pcall(function() ChangeCharEvent:FireServer(toonData) end) end
                    task.wait(1.5)
                end
                local slot1     = MainGui:FindFirstChild("Slot1") and MainGui.Slot1:FindFirstChild("ItemImage")
                local wrenchOn  = slot1 and slot1.Visible and slot1.Image == FallbackConfig.TrinketImage
                if not wrenchOn then
                    if currentIchor >= FallbackConfig.TrinketCost then
                        print("Membeli Trinket: " .. FallbackConfig.TrinketToBuy)
                        pcall(function() ReplicatedStorage:WaitForChild("BuyTrinket"):InvokeServer(FallbackConfig.TrinketToBuy) end)
                        task.wait(1.5)
                        -- Equip Wrench langsung, bukan SmartEquipTrinkets (yang nyoba VeeRemote+StressBall)
                        local EquipTrinket = ReplicatedStorage:WaitForChild("EquipTrinket")
                        local maxTry = 10
                        local try = 0
                        repeat
                            try += 1
                            pcall(function() EquipTrinket:InvokeServer("None", "UnEquipAll") end)
                            task.wait(1)
                            pcall(function() EquipTrinket:InvokeServer(FallbackConfig.TrinketToBuy, "Equip") end)
                            task.wait(1)
                            local s1 = MainGui:FindFirstChild("Slot1") and MainGui.Slot1:FindFirstChild("ItemImage")
                            wrenchOn = s1 and s1.Visible and s1.Image == FallbackConfig.TrinketImage
                        until wrenchOn or try >= maxTry
                        if wrenchOn then
                            print("✅ Wrench berhasil terpasang!")
                        else
                            warn("❌ Gagal pasang Wrench setelah " .. maxTry .. "x.")
                        end
                    else
                        print("Ichor belum cukup untuk Trinket (" .. currentIchor .. "/" .. FallbackConfig.TrinketCost .. ").")
                    end
                else
                    print("✅ Wrench sudah terpasang. Skip.")
                end
            end
        end
    end
end

