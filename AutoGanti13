local function SmartEquipTrinkets()
    local EquipTrinket = ReplicatedStorage:WaitForChild("EquipTrinket")
    local maxRetries   = 25
    local attempts     = 0
    repeat
        attempts += 1
        if correctTrinketsEquipped() then
            print("✅ Trinket berhasil terpasang!")
            break
        end
        print("[Percobaan " .. attempts .. "] Trinket belum terpasang. Retry...")
        pcall(function() EquipTrinket:InvokeServer("None", "UnEquipAll") end)
        task.wait(1.5)
        for trinketName, _ in pairs(Config.TrinketsToUse) do
            pcall(function() EquipTrinket:InvokeServer(trinketName, "Equip") end)
            task.wait(1.5)
        end
    until attempts >= maxRetries
    if attempts >= maxRetries then warn("Gagal pasang trinket setelah " .. maxRetries .. "x.") end
end

