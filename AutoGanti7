    if game.PlaceId == LOBBY_PLACE_ID then
        local totalMasteryStars = 0
        for _, child in ipairs(charScrollFrame:GetChildren()) do
            if child:IsA("GuiObject") and child.Visible == true then
                local mStar = child:FindFirstChild("MasteryStar")
                if mStar and mStar.Visible == true then
                    totalMasteryStars = totalMasteryStars + 1
                end
            end
        end
        print("Total Mastery Star yang dimiliki: " .. totalMasteryStars)
        
        local ChangeCharEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("ChangeChar")
        local TowerDataFolder = ReplicatedStorage:WaitForChild("SharedData"):WaitForChild("TowerData")
        local currentToon = getCurrentlyUsedToon()

        -- AUTO BUY MAIN CHARACTER
        if totalMasteryStars >= Config.MasteryStarRequirement then
            print("Syarat Mastery Main Toon terpenuhi! Menjalankan Pembelian Ketat...")
            for _, mainToon in ipairs(Config.MainToonsToBuy) do
                local mainToonUI = charScrollFrame:FindFirstChild(mainToon)
                if mainToonUI and mainToonUI.Visible == false then
                    pcall(function() BuyTower:InvokeServer(mainToon) end)
                    task.wait(1.5) 
                    if mainToonUI.Visible == false then
                        print("❌ GAGAL MEMBELI " .. mainToon .. ". Pembelian Main Toon dihentikan.")
                        break 
                    end
                end
            end
        end

        -- AUTO BUY LAST ALL CHARACTER (END-GAME FARM)
