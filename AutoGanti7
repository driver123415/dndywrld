local currentTwisted = 0
local targetMet = false
local path1Twisted = 0
local path2Twisted = 0

local function extractNumber(text)
    if text and type(text) == "string" then
        local cleanText = string.gsub(text, ",", "")
        local num = string.match(cleanText, "%d+")
        return num and tonumber(num) or nil
    end
    return nil
end

local indicatorLabel = MainGui:FindFirstChild("Menu") and MainGui.Menu:FindFirstChild("LeftSide") and MainGui.Menu.LeftSide:FindFirstChild("MonsterButton") and MainGui.Menu.LeftSide.MonsterButton:FindFirstChild("NewIndicator") and MainGui.Menu.LeftSide.MonsterButton.NewIndicator:FindFirstChild("TextLabel")
if indicatorLabel and indicatorLabel.Text ~= "" and indicatorLabel.Parent.Visible == true then
    local indicatorNum = extractNumber(indicatorLabel.Text)
    if indicatorNum then path1Twisted = indicatorNum end
end

local statName = MainGui:FindFirstChild("StatFrame") and MainGui.StatFrame:FindFirstChild("ScrollingFrame") and MainGui.StatFrame.ScrollingFrame:FindFirstChild("Trinkets") and MainGui.StatFrame.ScrollingFrame.Trinkets:FindFirstChild("StatName")
if statName and statName.Text ~= "" then
    local totalTrinkets = extractNumber(statName.Text)
    if totalTrinkets then path2Twisted = math.max(0, totalTrinkets - Config.ShopTrinketsBought) end
end

currentTwisted = math.max(path1Twisted, path2Twisted)
if currentTwisted >= Config.TargetTwistedCount then targetMet = true end

-- ==========================================
-- =  FUNGSI SMART EQUIP TRINKET (BLOCKING) =
-- ==========================================
local function SmartEquipTrinkets(trinketList)
    local EquipTrinket = ReplicatedStorage:WaitForChild("EquipTrinket")
    local maxRetries = 25 
    local attempts = 0
    repeat
        attempts = attempts + 1
        local slot1 = MainGui:FindFirstChild("Slot1") and MainGui.Slot1:FindFirstChild("ItemImage")
        local slot2 = MainGui:FindFirstChild("Slot2") and MainGui.Slot2:FindFirstChild("ItemImage")
        local equippedCount = 0
        if slot1 and slot1.Visible then equippedCount = equippedCount + 1 end
        if slot2 and slot2.Visible then equippedCount = equippedCount + 1 end
        
        if equippedCount >= #trinketList then break end
        
        pcall(function() EquipTrinket:InvokeServer("None", "UnEquipAll") end)
        task.wait(1.5) 
        for _, trinketName in ipairs(trinketList) do
            pcall(function() EquipTrinket:InvokeServer(trinketName, "Equip") end)
            task.wait(1.5)
        end
    until (attempts >= maxRetries)
end

