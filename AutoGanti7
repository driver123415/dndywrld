            local targetFarmToon = Config.ToonForLastFarm[1]
            if currentToon ~= targetFarmToon then
                print("Memaksa Equip " .. targetFarmToon .. " untuk Farming Last Character...")
                local toonData = TowerDataFolder:FindFirstChild(targetFarmToon)
                if toonData then pcall(function() ChangeCharEvent:FireServer(toonData) end) end
                task.wait(1.5)
            end

            -- Pembelian Berurutan Ketat Sisa Karakter
            for _, lastToon in ipairs(Config.LastToonsToBuy) do
                local lastToonUI = charScrollFrame:FindFirstChild(lastToon)
                if lastToonUI and lastToonUI.Visible == false then
                    print("Mencoba membeli Last Toon: " .. lastToon)
                    pcall(function() BuyTower:InvokeServer(lastToon) end)
                    task.wait(1.5)
                    
                    if lastToonUI.Visible == false then
                        print("❌ GAGAL MEMBELI " .. lastToon .. ". Pembelian Last Toon dihentikan untuk menabung.")
                        break
                    end
                end
            end

            -- Validasi Akhir: Cek apakah SEMUA karakter di LastToonsToBuy sudah terbeli
            local allLastToonsOwned = true
            for _, lastToon in ipairs(Config.LastToonsToBuy) do
                local u = charScrollFrame:FindFirstChild(lastToon)
                if u and u.Visible == false then 
                    allLastToonsOwned = false 
                    break 
                end
            end

            -- Jika semua sudah kebeli, Beli Skin dan Pakai
            if allLastToonsOwned then
                print("✅ SEMUA LAST TOON SUDAH DIMILIKI! Membeli dan memakai Skin " .. Config.ToonLastSkinAndEquiped[1] .. "...")
                pcall(function() ReplicatedStorage:WaitForChild("BuySkin"):InvokeServer(Config.ToonLastSkinAndEquiped[1]) end)
