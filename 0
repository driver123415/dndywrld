print("Memulai Sistem Pantau Kick...")
-- ==============================================================================
-- SOLO STUCK DETECTOR V2 — DUAL TRIGGER (SOLO + GLOBAL TIMEOUT)
-- Trigger 1: Sendirian + stuck di floor yang sama > StuckTimeLimit
-- Trigger 2: Di floor yang sama > GlobalTimeoutLimit (berlaku walau ada teman)
-- ==============================================================================

local INGAME_PLACE_ID = 16552821455

if game.PlaceId ~= INGAME_PLACE_ID then
    warn("[SYSTEM] Script dibatalkan: Bukan INGAME.")
    return
end

local Players           = game:GetService("Players")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- ===================== KONFIGURASI =====================
local Config = {
    CheckInterval        = 2,     -- Seberapa sering ngecek (detik)

    -- TRIGGER 1: Solo
    MinPlayerToCheck     = 1,     -- Aktif jika total player <= angka ini (sendirian)
    SoloStuckTimeLimit   = 60,    -- Detik stuck sendirian sebelum rejoin (default 60 detik)

    -- TRIGGER 2: Global Timeout (berlaku walau ada teman)
    GlobalTimeoutLimit   = 1200,  -- 20 menit = 1200 detik, ganti sesuai kebutuhan
}
-- =======================================================

local isTeleporting  = false

-- Timer terpisah biar gak saling ganggu
local soloStuckTimer   = 0
local globalFloorTimer = 0

local lastFloorSolo    = nil
local lastFloorGlobal  = nil

-- ===================== HELPERS =====================

local function getPlayerCount()
    return #Players:GetPlayers()
end

local function getCurrentFloor()
    local floor = nil

    pcall(function()
        local pGui = player:WaitForChild("PlayerGui", 3)
        if not pGui then return end
        for _, ui in ipairs(pGui:GetDescendants()) do
            if ui:IsA("TextLabel") then
                local text = string.upper(ui.Text)
                local match = string.match(text, "FLOOR%s*(%d+)")
                if match then
                    floor = tonumber(match)
                    return
                end
            end
        end
    end)

    if not floor then
        pcall(function()
            local currentRoom = Workspace:FindFirstChild("CurrentRoom")
            if currentRoom then
                for _, child in ipairs(currentRoom:GetChildren()) do
                    if child:IsA("Model") then
                        local match = string.match(child.Name, "(%d+)")
                        if match then
                            floor = tonumber(match)
                            return
                        end
                    end
                end
            end
        end)
    end

    return floor
end

local function kickLocalPlayer(reason)
    warn("[SYSTEM] Kick dipicu! Alasan: " .. reason)

    pcall(function()
        if syn and syn.kick then syn.kick() return end
    end)
    pcall(function()
        Players.LocalPlayer:Kick("[Auto-Kick] " .. reason)
    end)
    pcall(function()
        game:GetService("TeleportService"):Teleport(1, player)
    end)
    pcall(function()
        if player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        end
    end)
end

local function teleportToLobby(reason)
    if isTeleporting then return end
    isTeleporting = true

    warn("[SYSTEM] Teleport ke Lobby! Alasan: " .. reason)

    pcall(function()
        ReplicatedStorage.Events.Teleport:FireServer()
    end)

    task.wait(8)

    if game.PlaceId == INGAME_PLACE_ID then
        warn("[SYSTEM] Teleport gagal. Memicu Auto-Kick...")
        kickLocalPlayer("Teleport gagal — " .. reason)
    end

    task.wait(5)
    isTeleporting = false
end

-- ===================== MAIN LOOP =====================

print(string.format(
    "[SYSTEM] Dual Trigger Aktif | Solo Timeout: %ds | Global Timeout: %ds (%.0f menit)",
    Config.SoloStuckTimeLimit,
    Config.GlobalTimeoutLimit,
    Config.GlobalTimeoutLimit / 60
))

task.spawn(function()
    while true do
        task.wait(Config.CheckInterval)

        if isTeleporting then continue end
        if not player.Character then continue end

        local totalPlayers = getPlayerCount()
        local currentFloor = getCurrentFloor()

        if currentFloor == nil then continue end

        -- ============================================================
        -- TRIGGER 1: SOLO STUCK
        -- Hanya jalan kalau sendirian
        -- ============================================================
        if totalPlayers <= Config.MinPlayerToCheck then

            if lastFloorSolo == nil then
                lastFloorSolo  = currentFloor
                soloStuckTimer = 0
            elseif currentFloor == lastFloorSolo then
                soloStuckTimer = soloStuckTimer + Config.CheckInterval

                local remaining = Config.SoloStuckTimeLimit - soloStuckTimer
                if remaining > 0 and remaining % 10 == 0 then
                    warn(string.format(
                        "[TRIGGER 1 - SOLO] Sendirian di Floor %d | Stuck %.0fs | %.0fs lagi...",
                        currentFloor, soloStuckTimer, remaining
                    ))
                end

                if soloStuckTimer >= Config.SoloStuckTimeLimit then
                    teleportToLobby(string.format(
                        "[TRIGGER 1] Sendirian & stuck di Floor %d selama %ds",
                        currentFloor, soloStuckTimer
                    ))
                    soloStuckTimer = 0
                    lastFloorSolo  = nil
                end
            else
                -- Floor berubah, reset solo timer
                print(string.format("[TRIGGER 1] Floor berubah %d → %d. Solo timer reset.", lastFloorSolo, currentFloor))
                lastFloorSolo  = currentFloor
                soloStuckTimer = 0
            end

        else
            -- Ada teman → reset solo timer & baseline
            soloStuckTimer = 0
            lastFloorSolo  = nil
        end

        -- ============================================================
        -- TRIGGER 2: GLOBAL TIMEOUT
        -- Jalan terus walau ada teman, hitung dari floor yang sama
        -- ============================================================
        if lastFloorGlobal == nil then
            lastFloorGlobal  = currentFloor
            globalFloorTimer = 0

        elseif currentFloor == lastFloorGlobal then
            globalFloorTimer = globalFloorTimer + Config.CheckInterval

            -- Log tiap 1 menit
            if globalFloorTimer % 60 == 0 then
                warn(string.format(
                    "[TRIGGER 2 - GLOBAL] Floor %d | Sudah %.0f menit (%.0f menit lagi sebelum timeout)",
                    currentFloor,
                    globalFloorTimer / 60,
                    (Config.GlobalTimeoutLimit - globalFloorTimer) / 60
                ))
            end

            if globalFloorTimer >= Config.GlobalTimeoutLimit then
                teleportToLobby(string.format(
                    "[TRIGGER 2] Stuck di Floor %d selama %.0f menit (ada %d player)",
                    currentFloor,
                    globalFloorTimer / 60,
                    totalPlayers
                ))
                globalFloorTimer = 0
                lastFloorGlobal  = nil
            end

        else
            -- Floor berubah, reset global timer
            print(string.format("[TRIGGER 2] Floor berubah %d → %d. Global timer reset.", lastFloorGlobal, currentFloor))
            lastFloorGlobal  = currentFloor
            globalFloorTimer = 0
        end

    end
end)

-- ===================== ANTISIPASI PLAYER KELUAR =====================
Players.PlayerRemoving:Connect(function(leavingPlayer)
    if leavingPlayer == player then return end
    task.wait(1)

    local remaining = getPlayerCount()
    if remaining <= Config.MinPlayerToCheck then
        warn("[SYSTEM] Player keluar! Sendirian sekarang. Solo timer mulai fresh.")
        soloStuckTimer = 0
        lastFloorSolo  = getCurrentFloor()
    end
end)
