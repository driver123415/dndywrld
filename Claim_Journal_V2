local MAX_RETRY = 3
local WAIT_BETWEEN = 0.2
local WAIT_RETRY = 1

local function getUnclaimedCount()
    local pGui = player:FindFirstChild("PlayerGui")
    local mainGui = pGui and pGui:FindFirstChild("MainGui")
    local indicator = mainGui
        and mainGui:FindFirstChild("Menu")
        and mainGui.Menu:FindFirstChild("LeftSide")
        and mainGui.Menu.LeftSide:FindFirstChild("DreamJournalButton")
        and mainGui.Menu.LeftSide.DreamJournalButton:FindFirstChild("NewIndicator")
        and mainGui.Menu.LeftSide.DreamJournalButton.NewIndicator:FindFirstChild("TextLabel")
    if not indicator then return 0 end
    if not mainGui.Menu.LeftSide.DreamJournalButton.NewIndicator.Visible then return 0 end
    return tonumber(indicator.Text) or 0
end

local function runClaim()
    local beforeCount = getUnclaimedCount()
    print("==================================================")
    print("🎯 JOURNAL CLAIM SCRIPT V3 - COMPLETE")
    print(string.format("📊 Unclaimed notif: %d", beforeCount))
    print(string.format("📋 Total IDs: %d", #achievementList))
    print("==================================================")

    local failed = {}

    for index, id in ipairs(achievementList) do
        local success, err = pcall(function()
            RemoteFunction:InvokeServer("AttemptRedeemAchievement", id)
        end)
        if success then
            print(string.format("[%d/%d] ✅ %s", index, #achievementList, id))
        else
            warn(string.format("[%d/%d] ❌ %s | %s", index, #achievementList, id, tostring(err)))
            table.insert(failed, id)
        end
        task.wait(WAIT_BETWEEN)
    end

    local attempt = 1
    while #failed > 0 and attempt <= MAX_RETRY do
        print(string.format("🔁 RETRY #%d — %d failed...", attempt, #failed))
        task.wait(WAIT_RETRY)
        local stillFailed = {}
        for _, id in ipairs(failed) do
            local success, err = pcall(function()
                RemoteFunction:InvokeServer("AttemptRedeemAchievement", id)
            end)
            if success then
                print("✅ RETRY OK: " .. id)
            else
                warn("❌ RETRY fail: " .. id .. " | " .. tostring(err))
                table.insert(stillFailed, id)
            end
            task.wait(WAIT_BETWEEN)
        end
        failed = stillFailed
        attempt = attempt + 1
    end

    task.wait(1)
    local afterCount = getUnclaimedCount()
    print("==================================================")
    print(string.format("📊 Unclaimed sebelum : %d", beforeCount))
    print(string.format("📊 Unclaimed sesudah : %d", afterCount))
    if afterCount == 0 then
        print("🎉 Semua journal berhasil di-claim!")
    else
        print(string.format("⚠️ Masih ada %d yang belum ke-claim", afterCount))
    end
    if #failed > 0 then
        print("❌ Permanently failed:")
        for _, id in ipairs(failed) do print("   └─ " .. id) end
    end
    print("==================================================")
end

runClaim()
