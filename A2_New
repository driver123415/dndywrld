-- =======================================================
-- SMART REWRITE — STRING (untuk file flag)
-- Cek isi file sebelum nulis, skip jika sudah sama
-- =======================================================
local function smartWriteFile(filePath, targetContent)
    if not writefile then
        warn("[AutoConfig] Executor tidak mendukung writefile!")
        return
    end

    local needWrite = true

    if isfile and readfile and isfile(filePath) then
        local success, currentContent = pcall(readfile, filePath)
        if success and currentContent then
            local cleanCurrent = string.gsub(currentContent, "^%s*(.-)%s*$", "%1")
            local cleanTarget  = string.gsub(tostring(targetContent), "^%s*(.-)%s*$", "%1")
            if cleanCurrent == cleanTarget then
                needWrite = false
            end
        end
    end

    if needWrite then
        local ok, err = pcall(writefile, filePath, tostring(targetContent))
        if ok then
            print("[AutoConfig] File diperbarui: " .. filePath)
        else
            warn("[AutoConfig] Gagal menulis " .. filePath .. ": " .. tostring(err))
        end
    else
        print("[AutoConfig] Skip Rewrite: " .. filePath)
    end
end

-- =======================================================
-- SMART REWRITE — JSON (compare nilai bukan string)
-- Kebal urutan key acak, nggak false-trigger rewrite
-- =======================================================
local function isTableEqual(t1, t2)
    if type(t1) ~= "table" or type(t2) ~= "table" then return t1 == t2 end
    for k, v in pairs(t1) do
        if t2[k] ~= v then return false end
    end
    for k, v in pairs(t2) do
        if t1[k] ~= v then return false end
    end
    return true
end

local function smartWriteJSON(filePath, targetTable)
    if not writefile then
        warn("[AutoConfig] Executor tidak mendukung writefile!")
        return
    end

    local needWrite = true

    if isfile and readfile and isfile(filePath) then
        local success, currentContent = pcall(readfile, filePath)
        if success and currentContent then
            local decodeOk, currentTable = pcall(function()
                return HttpService:JSONDecode(currentContent)
            end)
            if decodeOk and type(currentTable) == "table" then
                if isTableEqual(currentTable, targetTable) then
                    needWrite = false
                end
            end
        end
    end

    if needWrite then
        local okEncode, jsonString = pcall(function()
            return HttpService:JSONEncode(targetTable)
        end)
        if okEncode then
            local okWrite, err = pcall(writefile, filePath, jsonString)
            if okWrite then
                print("[AutoConfig] File diperbarui: " .. filePath)
            else
                warn("[AutoConfig] Gagal menulis " .. filePath .. ": " .. tostring(err))
            end
        end
    else
        print("[AutoConfig] Skip Rewrite (Data sudah sama): " .. filePath)
    end
end

-- =======================================================
-- WRITE KEY — Plain write tanpa pcall (ikutin cara sadapan)
-- pcall di Delta bikin writefile jalan setengah, file kosong
-- =======================================================
local function writeKey(filePath, keyValue)
    if not writefile then
        warn("[KeyWriter] Executor tidak mendukung writefile!")
        return
    end
    writefile(filePath, tostring(keyValue))
    print("[KeyWriter] ✅ Key ditulis: " .. filePath)
end

