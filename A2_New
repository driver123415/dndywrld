-- =======================================================
-- AUTO-ON WEBHOOK
-- Fire signal ke tombol "Start Webhook Logging" di GUI
-- Path: YattasUniqueGUI > MainFrame > UIRoot > ContentArea
--       > PageWebhook > ToggleList > ToggleRow > TogWrapper
-- TogStateLbl & TogClickBtn ada di dalam TogWrapper (bukan langsung di ToggleRow)
-- Dikontrol oleh AUTO_NYALAKAN_WEBHOOK di Pengaturan Utama
-- =======================================================
local function enableWebhookToggle()
    if not AUTO_NYALAKAN_WEBHOOK then
        print("[AutoWebhook] Mode OFF, skip.")
        return
    end

    task.spawn(function()
        local Players   = game:GetService("Players")
        local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui", 30)

        -- Tunggu GUI Yatta muncul
        local yattaGui = playerGui:FindFirstChild("YattasUniqueGUI")
            or playerGui:WaitForChild("YattasUniqueGUI", 60)

        if not yattaGui then
            warn("[AutoWebhook] YattasUniqueGUI not found.")
            return
        end

        task.wait(2) -- Grace period: tunggu GUI fully init & config ke-load

        -- Navigasi ke tombol toggle webhook
        local togWrapper = yattaGui
            :FindFirstChild("MainFrame")
            :FindFirstChild("UIRoot")
            :FindFirstChild("ContentArea")
            :FindFirstChild("PageWebhook")
            :FindFirstChild("ToggleList_WebHook_Logging")
            :FindFirstChild("ToggleRow_StartWebhookLogging")
            :FindFirstChild("TogWrapper") -- TogStateLbl & TogClickBtn ada di sini

        if not togWrapper then
            warn("[AutoWebhook] TogWrapper not found.")
            return
        end

        local stateLbl = togWrapper:FindFirstChild("TogStateLbl") -- Label "On"/"Off"
        local clickBtn = togWrapper:FindFirstChild("TogClickBtn") -- Tombol kliknya

        if not stateLbl or not clickBtn then
            warn("[AutoWebhook] TogStateLbl/TogClickBtn not found.")
            return
        end

        if stateLbl.Text == "On" then
            print("[AutoWebhook] Already On, skip.")
            return
        end

        -- Fire semua signal yang mungkin dipakai GUI
        if firesignal then
            pcall(function() firesignal(clickBtn.MouseButton1Click) end)
            task.wait(0.1)
            pcall(function() firesignal(clickBtn.Activated) end)
            task.wait(0.1)
            pcall(function() firesignal(clickBtn.MouseButton1Down) end)
            task.wait(0.05)
            pcall(function() firesignal(clickBtn.MouseButton1Up) end)
        end

        task.wait(0.3)
        print("[AutoWebhook] ✅ Webhook Logging: " .. stateLbl.Text)
    end)
end

