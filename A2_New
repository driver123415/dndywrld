-- =======================================================
-- SMART REWRITE
-- Cek isi file sebelum nulis, skip jika sudah sama
-- =======================================================
if isfolder and makefolder and not isfolder(FOLDER_PATH) then
    makefolder(FOLDER_PATH)
end

local function smartWriteFile(filePath, targetContent)
    if not writefile then
        warn("[AutoConfig] Executor tidak mendukung writefile!")
        return
    end

    local needWrite = true

    if isfile and readfile and isfile(filePath) then
        local success, currentContent = pcall(readfile, filePath)
        if success and currentContent then
            local cleanCurrent = string.gsub(currentContent, "^%s*(.-)%s*$", "%1")
            local cleanTarget  = string.gsub(tostring(targetContent), "^%s*(.-)%s*$", "%1")
            if cleanCurrent == cleanTarget then
                needWrite = false
            end
        end
    end

    if needWrite then
        local ok, err = pcall(writefile, filePath, tostring(targetContent))
        if ok then
            print("[AutoConfig] File diperbarui: " .. filePath)
        else
            warn("[AutoConfig] Gagal menulis " .. filePath .. ": " .. tostring(err))
        end
    else
        print("[AutoConfig] Skip Rewrite: " .. filePath)
    end
end

